 "verses": [
  {
   "k": "38:1",
   "n": 1,
   "c": 38,
   "text": "صٓ ۚ وَٱلْقُرْءَانِ ذِى ٱلذِّكْرِ"
  },
  {
   "k": "38:2",
   "n": 2,
   "c": 38,
   "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى عِزَّةٍۢ وَشِقَاقٍۢ"
  },
  {
   "k": "38:3",
   "n": 3,
   "c": 38,
   "text": "كَمْ أَهْلَكْنَا مِن قَبْلِهِم مِّن قَرْنٍۢ فَنَادَوا۟ وَّلَاتَ حِينَ مَنَاصٍۢ"
  },
  {
   "k": "38:4",
   "n": 4,
   "c": 38,
   "text": "وَعَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌۭ مِّنْهُمْ ۖ وَقَالَ ٱلْكَـٰفِرُونَ هَـٰذَا سَـٰحِرٌۭ كَذَّابٌ"
  },
  {
   "k": "38:5",
   "n": 5,
   "c": 38,
   "text": "أَجَعَلَ ٱلْـَٔالِهَةَ إِلَـٰهًۭا وَٰحِدًا ۖ إِنَّ هَـٰذَا لَشَىْءٌ عُجَابٌۭ"
  },
  {
   "k": "38:6",
   "n": 6,
   "c": 38,
   "text": "وَٱنطَلَقَ ٱلْمَلَأُ مِنْهُمْ أَنِ ٱمْشُوا۟ وَٱصْبِرُوا۟ عَلَىٰٓ ءَالِهَتِكُمْ ۖ إِنَّ هَـٰذَا لَشَىْءٌۭ يُرَادُ"
  },
  {
   "k": "38:7",
   "n": 7,
   "c": 38,
   "text": "مَا سَمِعْنَا بِهَـٰذَا فِى ٱلْمِلَّةِ ٱلْـَٔاخِرَةِ إِنْ هَـٰذَآ إِلَّا ٱخْتِلَـٰقٌ"
  },
  {
   "k": "38:8",
   "n": 8,
   "c": 38,
   "text": "أَءُنزِلَ عَلَيْهِ ٱلذِّكْرُ مِنۢ بَيْنِنَا ۚ بَلْ هُمْ فِى شَكٍّۢ مِّن ذِكْرِى ۖ بَل لَّمَّا يَذُوقُوا۟ عَذَابِ"
  },
  {
   "k": "38:9",
   "n": 9,
   "c": 38,
   "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَحْمَةِ رَبِّكَ ٱلْعَزِيزِ ٱلْوَهَّابِ"
  },
  {
   "k": "38:10",
   "n": 10,
   "c": 38,
   "text": "أَمْ لَهُم مُّلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ۖ فَلْيَرْتَقُوا۟ فِى ٱلْأَسْبَـٰبِ"
  },
  {
   "k": "38:11",
   "n": 11,
   "c": 38,
   "text": "جُندٌۭ مَّا هُنَالِكَ مَهْزُومٌۭ مِّنَ ٱلْأَحْزَابِ"
  },
  {
   "k": "38:12",
   "n": 12,
   "c": 38,
   "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍۢ وَعَادٌۭ وَفِرْعَوْنُ ذُو ٱلْأَوْتَادِ"
  },
  {
   "k": "38:13",
   "n": 13,
   "c": 38,
   "text": "وَثَمُودُ وَقَوْمُ لُوطٍۢ وَأَصْحَـٰبُ لْـَٔيْكَةِ ۚ أُو۟لَـٰٓئِكَ ٱلْأَحْزَابُ"
  },
  {
   "k": "38:14",
   "n": 14,
   "c": 38,
   "text": "إِن كُلٌّ إِلَّا كَذَّبَ ٱلرُّسُلَ فَحَقَّ عِقَابِ"
  },
  {
   "k": "38:15",
   "n": 15,
   "c": 38,
   "text": "وَمَا يَنظُرُ هَـٰٓؤُلَآءِ إِلَّا صَيْحَةًۭ وَٰحِدَةًۭ مَّا لَهَا مِن فَوَاقٍۢ"
  },
  {
   "k": "38:16",
   "n": 16,
   "c": 38,
   "text": "وَقَالُوا۟ رَبَّنَا عَجِّل لَّنَا قِطَّنَا قَبْلَ يَوْمِ ٱلْحِسَابِ"
  }
 ]
}
