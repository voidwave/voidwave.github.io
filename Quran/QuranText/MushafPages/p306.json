 "verses": [
  {
   "k": "19:12",
   "n": 12,
   "c": 19,
   "text": "يَـٰيَحْيَىٰ خُذِ ٱلْكِتَـٰبَ بِقُوَّةٍۢ ۖ وَءَاتَيْنَـٰهُ ٱلْحُكْمَ صَبِيًّۭا"
  },
  {
   "k": "19:13",
   "n": 13,
   "c": 19,
   "text": "وَحَنَانًۭا مِّن لَّدُنَّا وَزَكَوٰةًۭ ۖ وَكَانَ تَقِيًّۭا"
  },
  {
   "k": "19:14",
   "n": 14,
   "c": 19,
   "text": "وَبَرًّۢا بِوَٰلِدَيْهِ وَلَمْ يَكُن جَبَّارًا عَصِيًّۭا"
  },
  {
   "k": "19:15",
   "n": 15,
   "c": 19,
   "text": "وَسَلَـٰمٌ عَلَيْهِ يَوْمَ وُلِدَ وَيَوْمَ يَمُوتُ وَيَوْمَ يُبْعَثُ حَيًّۭا"
  },
  {
   "k": "19:16",
   "n": 16,
   "c": 19,
   "text": "وَٱذْكُرْ فِى ٱلْكِتَـٰبِ مَرْيَمَ إِذِ ٱنتَبَذَتْ مِنْ أَهْلِهَا مَكَانًۭا شَرْقِيًّۭا"
  },
  {
   "k": "19:17",
   "n": 17,
   "c": 19,
   "text": "فَٱتَّخَذَتْ مِن دُونِهِمْ حِجَابًۭا فَأَرْسَلْنَآ إِلَيْهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَرًۭا سَوِيًّۭا"
  },
  {
   "k": "19:18",
   "n": 18,
   "c": 19,
   "text": "قَالَتْ إِنِّىٓ أَعُوذُ بِٱلرَّحْمَـٰنِ مِنكَ إِن كُنتَ تَقِيًّۭا"
  },
  {
   "k": "19:19",
   "n": 19,
   "c": 19,
   "text": "قَالَ إِنَّمَآ أَنَا۠ رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَـٰمًۭا زَكِيًّۭا"
  },
  {
   "k": "19:20",
   "n": 20,
   "c": 19,
   "text": "قَالَتْ أَنَّىٰ يَكُونُ لِى غُلَـٰمٌۭ وَلَمْ يَمْسَسْنِى بَشَرٌۭ وَلَمْ أَكُ بَغِيًّۭا"
  },
  {
   "k": "19:21",
   "n": 21,
   "c": 19,
   "text": "قَالَ كَذَٰلِكِ قَالَ رَبُّكِ هُوَ عَلَىَّ هَيِّنٌۭ ۖ وَلِنَجْعَلَهُۥٓ ءَايَةًۭ لِّلنَّاسِ وَرَحْمَةًۭ مِّنَّا ۚ وَكَانَ أَمْرًۭا مَّقْضِيًّۭا"
  },
  {
   "k": "19:22",
   "n": 22,
   "c": 19,
   "text": "۞ فَحَمَلَتْهُ فَٱنتَبَذَتْ بِهِۦ مَكَانًۭا قَصِيًّۭا"
  },
  {
   "k": "19:23",
   "n": 23,
   "c": 19,
   "text": "فَأَجَآءَهَا ٱلْمَخَاضُ إِلَىٰ جِذْعِ ٱلنَّخْلَةِ قَالَتْ يَـٰلَيْتَنِى مِتُّ قَبْلَ هَـٰذَا وَكُنتُ نَسْيًۭا مَّنسِيًّۭا"
  },
  {
   "k": "19:24",
   "n": 24,
   "c": 19,
   "text": "فَنَادَىٰهَا مِن تَحْتِهَآ أَلَّا تَحْزَنِى قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّۭا"
  },
  {
   "k": "19:25",
   "n": 25,
   "c": 19,
   "text": "وَهُزِّىٓ إِلَيْكِ بِجِذْعِ ٱلنَّخْلَةِ تُسَـٰقِطْ عَلَيْكِ رُطَبًۭا جَنِيًّۭا"
  }
 ]
}
