 "verses": [
  {
   "k": "41:1",
   "n": 1,
   "c": 41,
   "text": "حمٓ"
  },
  {
   "k": "41:2",
   "n": 2,
   "c": 41,
   "text": "تَنزِيلٌۭ مِّنَ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"
  },
  {
   "k": "41:3",
   "n": 3,
   "c": 41,
   "text": "كِتَـٰبٌۭ فُصِّلَتْ ءَايَـٰتُهُۥ قُرْءَانًا عَرَبِيًّۭا لِّقَوْمٍۢ يَعْلَمُونَ"
  },
  {
   "k": "41:4",
   "n": 4,
   "c": 41,
   "text": "بَشِيرًۭا وَنَذِيرًۭا فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَ"
  },
  {
   "k": "41:5",
   "n": 5,
   "c": 41,
   "text": "وَقَالُوا۟ قُلُوبُنَا فِىٓ أَكِنَّةٍۢ مِّمَّا تَدْعُونَآ إِلَيْهِ وَفِىٓ ءَاذَانِنَا وَقْرٌۭ وَمِنۢ بَيْنِنَا وَبَيْنِكَ حِجَابٌۭ فَٱعْمَلْ إِنَّنَا عَـٰمِلُونَ"
  },
  {
   "k": "41:6",
   "n": 6,
   "c": 41,
   "text": "قُلْ إِنَّمَآ أَنَا۠ بَشَرٌۭ مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَـٰهُكُمْ إِلَـٰهٌۭ وَٰحِدٌۭ فَٱسْتَقِيمُوٓا۟ إِلَيْهِ وَٱسْتَغْفِرُوهُ ۗ وَوَيْلٌۭ لِّلْمُشْرِكِينَ"
  },
  {
   "k": "41:7",
   "n": 7,
   "c": 41,
   "text": "ٱلَّذِينَ لَا يُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْـَٔاخِرَةِ هُمْ كَـٰفِرُونَ"
  },
  {
   "k": "41:8",
   "n": 8,
   "c": 41,
   "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ"
  },
  {
   "k": "41:9",
   "n": 9,
   "c": 41,
   "text": "۞ قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ بِٱلَّذِى خَلَقَ ٱلْأَرْضَ فِى يَوْمَيْنِ وَتَجْعَلُونَ لَهُۥٓ أَندَادًۭا ۚ ذَٰلِكَ رَبُّ ٱلْعَـٰلَمِينَ"
  },
  {
   "k": "41:10",
   "n": 10,
   "c": 41,
   "text": "وَجَعَلَ فِيهَا رَوَٰسِىَ مِن فَوْقِهَا وَبَـٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقْوَٰتَهَا فِىٓ أَرْبَعَةِ أَيَّامٍۢ سَوَآءًۭ لِّلسَّآئِلِينَ"
  },
  {
   "k": "41:11",
   "n": 11,
   "c": 41,
   "text": "ثُمَّ ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِىَ دُخَانٌۭ فَقَالَ لَهَا وَلِلْأَرْضِ ٱئْتِيَا طَوْعًا أَوْ كَرْهًۭا قَالَتَآ أَتَيْنَا طَآئِعِينَ"
  }
 ]
}
