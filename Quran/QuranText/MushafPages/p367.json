   "k": "26:3",
   "n": 3,
   "c": 26,
   "text": "لَعَلَّكَ بَـٰخِعٌۭ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ"
  },
  {
   "k": "26:4",
   "n": 4,
   "c": 26,
   "text": "إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةًۭ فَظَلَّتْ أَعْنَـٰقُهُمْ لَهَا خَـٰضِعِينَ"
  },
  {
   "k": "26:5",
   "n": 5,
   "c": 26,
   "text": "وَمَا يَأْتِيهِم مِّن ذِكْرٍۢ مِّنَ ٱلرَّحْمَـٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ"
  },
  {
   "k": "26:6",
   "n": 6,
   "c": 26,
   "text": "فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَـٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ"
  },
  {
   "k": "26:7",
   "n": 7,
   "c": 26,
   "text": "أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍۢ كَرِيمٍ"
  },
  {
   "k": "26:8",
   "n": 8,
   "c": 26,
   "text": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
  },
  {
   "k": "26:9",
   "n": 9,
   "c": 26,
   "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
  },
  {
   "k": "26:10",
   "n": 10,
   "c": 26,
   "text": "وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّـٰلِمِينَ"
  },
  {
   "k": "26:11",
   "n": 11,
   "c": 26,
   "text": "قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّقُونَ"
  },
  {
   "k": "26:12",
   "n": 12,
   "c": 26,
   "text": "قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ"
  },
  {
   "k": "26:13",
   "n": 13,
   "c": 26,
   "text": "وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَـٰرُونَ"
  },
  {
   "k": "26:14",
   "n": 14,
   "c": 26,
   "text": "وَلَهُمْ عَلَىَّ ذَنۢبٌۭ فَأَخَافُ أَن يَقْتُلُونِ"
  },
  {
   "k": "26:15",
   "n": 15,
   "c": 26,
   "text": "قَالَ كَلَّا ۖ فَٱذْهَبَا بِـَٔايَـٰتِنَآ ۖ إِنَّا مَعَكُم مُّسْتَمِعُونَ"
  },
  {
   "k": "26:16",
   "n": 16,
   "c": 26,
   "text": "فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَـٰلَمِينَ"
  },
  {
   "k": "26:17",
   "n": 17,
   "c": 26,
   "text": "أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ"
  },
  {
   "k": "26:18",
   "n": 18,
   "c": 26,
   "text": "قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًۭا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ"
  },
  {
   "k": "26:19",
   "n": 19,
   "c": 26,
   "text": "وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَـٰفِرِينَ"
  }
 ]
}
