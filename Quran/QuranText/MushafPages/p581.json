 "verses": [
  {
   "k": "77:20",
   "n": 20,
   "c": 77,
   "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ"
  },
  {
   "k": "77:21",
   "n": 21,
   "c": 77,
   "text": "فَجَعَلْنَـٰهُ فِى قَرَارٍۢ مَّكِينٍ"
  },
  {
   "k": "77:22",
   "n": 22,
   "c": 77,
   "text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ"
  },
  {
   "k": "77:23",
   "n": 23,
   "c": 77,
   "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ"
  },
  {
   "k": "77:24",
   "n": 24,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:25",
   "n": 25,
   "c": 77,
   "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"
  },
  {
   "k": "77:26",
   "n": 26,
   "c": 77,
   "text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا"
  },
  {
   "k": "77:27",
   "n": 27,
   "c": 77,
   "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍۢ وَأَسْقَيْنَـٰكُم مَّآءًۭ فُرَاتًۭا"
  },
  {
   "k": "77:28",
   "n": 28,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:29",
   "n": 29,
   "c": 77,
   "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"
  },
  {
   "k": "77:30",
   "n": 30,
   "c": 77,
   "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَـٰثِ شُعَبٍۢ"
  },
  {
   "k": "77:31",
   "n": 31,
   "c": 77,
   "text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"
  },
  {
   "k": "77:32",
   "n": 32,
   "c": 77,
   "text": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ"
  },
  {
   "k": "77:33",
   "n": 33,
   "c": 77,
   "text": "كَأَنَّهُۥ جِمَـٰلَتٌۭ صُفْرٌۭ"
  },
  {
   "k": "77:34",
   "n": 34,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:35",
   "n": 35,
   "c": 77,
   "text": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ"
  },
  {
   "k": "77:36",
   "n": 36,
   "c": 77,
   "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"
  },
  {
   "k": "77:37",
   "n": 37,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:38",
   "n": 38,
   "c": 77,
   "text": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ"
  },
  {
   "k": "77:39",
   "n": 39,
   "c": 77,
   "text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ"
  },
  {
   "k": "77:40",
   "n": 40,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:41",
   "n": 41,
   "c": 77,
   "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍۢ وَعُيُونٍۢ"
  },
  {
   "k": "77:42",
   "n": 42,
   "c": 77,
   "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"
  },
  {
   "k": "77:43",
   "n": 43,
   "c": 77,
   "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"
  },
  {
   "k": "77:44",
   "n": 44,
   "c": 77,
   "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
  },
  {
   "k": "77:45",
   "n": 45,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:46",
   "n": 46,
   "c": 77,
   "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"
  },
  {
   "k": "77:47",
   "n": 47,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:48",
   "n": 48,
   "c": 77,
   "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"
  },
  {
   "k": "77:49",
   "n": 49,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:50",
   "n": 50,
   "c": 77,
   "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"
  }
 ]
}
