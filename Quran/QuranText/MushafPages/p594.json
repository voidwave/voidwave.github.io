 "verses": [
  {
   "k": "89:23",
   "n": 23,
   "c": 89,
   "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"
  },
  {
   "k": "89:24",
   "n": 24,
   "c": 89,
   "text": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"
  },
  {
   "k": "89:25",
   "n": 25,
   "c": 89,
   "text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ"
  },
  {
   "k": "89:26",
   "n": 26,
   "c": 89,
   "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ"
  },
  {
   "k": "89:27",
   "n": 27,
   "c": 89,
   "text": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"
  },
  {
   "k": "89:28",
   "n": 28,
   "c": 89,
   "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ"
  },
  {
   "k": "89:29",
   "n": 29,
   "c": 89,
   "text": "فَٱدْخُلِى فِى عِبَـٰدِى"
  },
  {
   "k": "89:30",
   "n": 30,
   "c": 89,
   "text": "وَٱدْخُلِى جَنَّتِى"
  },
  {
   "k": "90:1",
   "n": 1,
   "c": 90,
   "text": "لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ"
  },
  {
   "k": "90:2",
   "n": 2,
   "c": 90,
   "text": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ"
  },
  {
   "k": "90:3",
   "n": 3,
   "c": 90,
   "text": "وَوَالِدٍۢ وَمَا وَلَدَ"
  },
  {
   "k": "90:4",
   "n": 4,
   "c": 90,
   "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ"
  },
  {
   "k": "90:5",
   "n": 5,
   "c": 90,
   "text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ"
  },
  {
   "k": "90:6",
   "n": 6,
   "c": 90,
   "text": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا"
  },
  {
   "k": "90:7",
   "n": 7,
   "c": 90,
   "text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"
  },
  {
   "k": "90:8",
   "n": 8,
   "c": 90,
   "text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"
  },
  {
   "k": "90:9",
   "n": 9,
   "c": 90,
   "text": "وَلِسَانًۭا وَشَفَتَيْنِ"
  },
  {
   "k": "90:10",
   "n": 10,
   "c": 90,
   "text": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ"
  },
  {
   "k": "90:11",
   "n": 11,
   "c": 90,
   "text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"
  },
  {
   "k": "90:12",
   "n": 12,
   "c": 90,
   "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"
  },
  {
   "k": "90:13",
   "n": 13,
   "c": 90,
   "text": "فَكُّ رَقَبَةٍ"
  },
  {
   "k": "90:14",
   "n": 14,
   "c": 90,
   "text": "أَوْ إِطْعَـٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ"
  },
  {
   "k": "90:15",
   "n": 15,
   "c": 90,
   "text": "يَتِيمًۭا ذَا مَقْرَبَةٍ"
  },
  {
   "k": "90:16",
   "n": 16,
   "c": 90,
   "text": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ"
  },
  {
   "k": "90:17",
   "n": 17,
   "c": 90,
