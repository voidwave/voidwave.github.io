 "verses": [
  {
   "k": "103:1",
   "n": 1,
   "c": 103,
   "text": "وَٱلْعَصْرِ"
  },
  {
   "k": "103:2",
   "n": 2,
   "c": 103,
   "text": "إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ"
  },
  {
   "k": "103:3",
   "n": 3,
   "c": 103,
   "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"
  },
  {
   "k": "104:1",
   "n": 1,
   "c": 104,
   "text": "وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ"
  },
  {
   "k": "104:2",
   "n": 2,
   "c": 104,
   "text": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ"
  },
  {
   "k": "104:3",
   "n": 3,
   "c": 104,
   "text": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"
  },
  {
   "k": "104:4",
   "n": 4,
   "c": 104,
   "text": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"
  },
  {
   "k": "104:5",
   "n": 5,
   "c": 104,
   "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"
  },
  {
   "k": "104:6",
   "n": 6,
   "c": 104,
   "text": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"
  },
  {
   "k": "104:7",
   "n": 7,
   "c": 104,
   "text": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"
  },
  {
   "k": "104:8",
   "n": 8,
   "c": 104,
   "text": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ"
  },
  {
   "k": "104:9",
   "n": 9,
   "c": 104,
   "text": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ"
  },
  {
   "k": "105:1",
   "n": 1,
   "c": 105,
   "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"
  },
  {
   "k": "105:2",
   "n": 2,
   "c": 105,
   "text": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ"
  },
  {
   "k": "105:3",
   "n": 3,
   "c": 105,
   "text": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"
  },
  {
   "k": "105:4",
   "n": 4,
   "c": 105,
   "text": "تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ"
  },
  {
   "k": "105:5",
   "n": 5,
   "c": 105,
   "text": "فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ"
  }
 ]
}
