 "verses": [
  {
   "k": "70:40",
   "n": 40,
   "c": 70,
   "text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ"
  },
  {
   "k": "70:41",
   "n": 41,
   "c": 70,
   "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ"
  },
  {
   "k": "70:42",
   "n": 42,
   "c": 70,
   "text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ"
  },
  {
   "k": "70:43",
   "n": 43,
   "c": 70,
   "text": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ يُوفِضُونَ"
  },
  {
   "k": "70:44",
   "n": 44,
   "c": 70,
   "text": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ"
  },
  {
   "k": "71:1",
   "n": 1,
   "c": 71,
   "text": "إِنَّآ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦٓ أَنْ أَنذِرْ قَوْمَكَ مِن قَبْلِ أَن يَأْتِيَهُمْ عَذَابٌ أَلِيمٌۭ"
  },
  {
   "k": "71:2",
   "n": 2,
   "c": 71,
   "text": "قَالَ يَـٰقَوْمِ إِنِّى لَكُمْ نَذِيرٌۭ مُّبِينٌ"
  },
  {
   "k": "71:3",
   "n": 3,
   "c": 71,
   "text": "أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ"
  },
  {
   "k": "71:4",
   "n": 4,
   "c": 71,
   "text": "يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍۢ مُّسَمًّى ۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُ ۖ لَوْ كُنتُمْ تَعْلَمُونَ"
  },
  {
   "k": "71:5",
   "n": 5,
   "c": 71,
   "text": "قَالَ رَبِّ إِنِّى دَعَوْتُ قَوْمِى لَيْلًۭا وَنَهَارًۭا"
  },
  {
   "k": "71:6",
   "n": 6,
   "c": 71,
   "text": "فَلَمْ يَزِدْهُمْ دُعَآءِىٓ إِلَّا فِرَارًۭا"
  },
  {
   "k": "71:7",
   "n": 7,
   "c": 71,
   "text": "وَإِنِّى كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُوٓا۟ أَصَـٰبِعَهُمْ فِىٓ ءَاذَانِهِمْ وَٱسْتَغْشَوْا۟ ثِيَابَهُمْ وَأَصَرُّوا۟ وَٱسْتَكْبَرُوا۟ ٱسْتِكْبَارًۭا"
  },
  {
   "k": "71:8",
   "n": 8,
   "c": 71,
   "text": "ثُمَّ إِنِّى دَعَوْتُهُمْ جِهَارًۭا"
  },
  {
   "k": "71:9",
   "n": 9,
   "c": 71,
   "text": "ثُمَّ إِنِّىٓ أَعْلَنتُ لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًۭا"
  },
  {
   "k": "71:10",
   "n": 10,
   "c": 71,
   "text": "فَقُلْتُ ٱسْتَغْفِرُوا۟ رَبَّكُمْ إِنَّهُۥ كَانَ غَفَّارًۭا"
  }
 ]
}
