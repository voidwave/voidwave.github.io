 "verses": [
  {
   "k": "71:11",
   "n": 11,
   "c": 71,
   "text": "يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًۭا"
  },
  {
   "k": "71:12",
   "n": 12,
   "c": 71,
   "text": "وَيُمْدِدْكُم بِأَمْوَٰلٍۢ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّـٰتٍۢ وَيَجْعَل لَّكُمْ أَنْهَـٰرًۭا"
  },
  {
   "k": "71:13",
   "n": 13,
   "c": 71,
   "text": "مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًۭا"
  },
  {
   "k": "71:14",
   "n": 14,
   "c": 71,
   "text": "وَقَدْ خَلَقَكُمْ أَطْوَارًا"
  },
  {
   "k": "71:15",
   "n": 15,
   "c": 71,
   "text": "أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَـٰوَٰتٍۢ طِبَاقًۭا"
  },
  {
   "k": "71:16",
   "n": 16,
   "c": 71,
   "text": "وَجَعَلَ ٱلْقَمَرَ فِيهِنَّ نُورًۭا وَجَعَلَ ٱلشَّمْسَ سِرَاجًۭا"
  },
  {
   "k": "71:17",
   "n": 17,
   "c": 71,
   "text": "وَٱللَّهُ أَنۢبَتَكُم مِّنَ ٱلْأَرْضِ نَبَاتًۭا"
  },
  {
   "k": "71:18",
   "n": 18,
   "c": 71,
   "text": "ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًۭا"
  },
  {
   "k": "71:19",
   "n": 19,
   "c": 71,
   "text": "وَٱللَّهُ جَعَلَ لَكُمُ ٱلْأَرْضَ بِسَاطًۭا"
  },
  {
   "k": "71:20",
   "n": 20,
   "c": 71,
   "text": "لِّتَسْلُكُوا۟ مِنْهَا سُبُلًۭا فِجَاجًۭا"
  },
  {
   "k": "71:21",
   "n": 21,
   "c": 71,
   "text": "قَالَ نُوحٌۭ رَّبِّ إِنَّهُمْ عَصَوْنِى وَٱتَّبَعُوا۟ مَن لَّمْ يَزِدْهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارًۭا"
  },
  {
   "k": "71:22",
   "n": 22,
   "c": 71,
   "text": "وَمَكَرُوا۟ مَكْرًۭا كُبَّارًۭا"
  },
  {
   "k": "71:23",
   "n": 23,
   "c": 71,
   "text": "وَقَالُوا۟ لَا تَذَرُنَّ ءَالِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّۭا وَلَا سُوَاعًۭا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًۭا"
  },
  {
   "k": "71:24",
   "n": 24,
   "c": 71,
   "text": "وَقَدْ أَضَلُّوا۟ كَثِيرًۭا ۖ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا ضَلَـٰلًۭا"
  },
  {
   "k": "71:25",
   "n": 25,
   "c": 71,
   "text": "مِّمَّا خَطِيٓـَٔـٰتِهِمْ أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًۭا فَلَمْ يَجِدُوا۟ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارًۭا"
  },
  {
   "k": "71:26",
   "n": 26,
   "c": 71,
   "text": "وَقَالَ نُوحٌۭ رَّبِّ لَا تَذَرْ عَلَى ٱلْأَرْضِ مِنَ ٱلْكَـٰفِرِينَ دَيَّارًا"
  },
  {
   "k": "71:27",
   "n": 27,
   "c": 71,
   "text": "إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا۟ عِبَادَكَ وَلَا يَلِدُوٓا۟ إِلَّا فَاجِرًۭا كَفَّارًۭا"
  },
  {
   "k": "71:28",
   "n": 28,
   "c": 71,
   "text": "رَّبِّ ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ بَيْتِىَ مُؤْمِنًۭا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا تَبَارًۢا"
  }
 ]
}
