   "text": "أَمْ تَأْمُرُهُمْ أَحْلَـٰمُهُم بِهَـٰذَآ ۚ أَمْ هُمْ قَوْمٌۭ طَاغُونَ"
  },
  {
   "k": "52:33",
   "n": 33,
   "c": 52,
   "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ بَل لَّا يُؤْمِنُونَ"
  },
  {
   "k": "52:34",
   "n": 34,
   "c": 52,
   "text": "فَلْيَأْتُوا۟ بِحَدِيثٍۢ مِّثْلِهِۦٓ إِن كَانُوا۟ صَـٰدِقِينَ"
  },
  {
   "k": "52:35",
   "n": 35,
   "c": 52,
   "text": "أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَـٰلِقُونَ"
  },
  {
   "k": "52:36",
   "n": 36,
   "c": 52,
   "text": "أَمْ خَلَقُوا۟ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ"
  },
  {
   "k": "52:37",
   "n": 37,
   "c": 52,
   "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ"
  },
  {
   "k": "52:38",
   "n": 38,
   "c": 52,
   "text": "أَمْ لَهُمْ سُلَّمٌۭ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَـٰنٍۢ مُّبِينٍ"
  },
  {
   "k": "52:39",
   "n": 39,
   "c": 52,
   "text": "أَمْ لَهُ ٱلْبَنَـٰتُ وَلَكُمُ ٱلْبَنُونَ"
  },
  {
   "k": "52:40",
   "n": 40,
   "c": 52,
   "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ"
  },
  {
   "k": "52:41",
   "n": 41,
   "c": 52,
   "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ"
  },
  {
   "k": "52:42",
   "n": 42,
   "c": 52,
   "text": "أَمْ يُرِيدُونَ كَيْدًۭا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ"
  },
  {
   "k": "52:43",
   "n": 43,
   "c": 52,
   "text": "أَمْ لَهُمْ إِلَـٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَـٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ"
  },
  {
   "k": "52:44",
   "n": 44,
   "c": 52,
   "text": "وَإِن يَرَوْا۟ كِسْفًۭا مِّنَ ٱلسَّمَآءِ سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ مَّرْكُومٌۭ"
  },
  {
   "k": "52:45",
   "n": 45,
   "c": 52,
   "text": "فَذَرْهُمْ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ"
  },
  {
   "k": "52:46",
   "n": 46,
   "c": 52,
   "text": "يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ"
  },
  {
   "k": "52:47",
   "n": 47,
   "c": 52,
   "text": "وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًۭا دُونَ ذَٰلِكَ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ"
  },
  {
   "k": "52:48",
   "n": 48,
   "c": 52,
   "text": "وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ"
  },
  {
   "k": "52:49",
   "n": 49,
   "c": 52,
   "text": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَـٰرَ ٱلنُّجُومِ"
  }
 ]
}
