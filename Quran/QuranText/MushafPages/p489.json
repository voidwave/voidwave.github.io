 "verses": [
  {
   "k": "42:52",
   "n": 52,
   "c": 42,
   "text": "وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ رُوحًۭا مِّنْ أَمْرِنَا ۚ مَا كُنتَ تَدْرِى مَا ٱلْكِتَـٰبُ وَلَا ٱلْإِيمَـٰنُ وَلَـٰكِن جَعَلْنَـٰهُ نُورًۭا نَّهْدِى بِهِۦ مَن نَّشَآءُ مِنْ عِبَادِنَا ۚ وَإِنَّكَ لَتَهْدِىٓ إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ"
  },
  {
   "k": "42:53",
   "n": 53,
   "c": 42,
   "text": "صِرَٰطِ ٱللَّهِ ٱلَّذِى لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۗ أَلَآ إِلَى ٱللَّهِ تَصِيرُ ٱلْأُمُورُ"
  },
  {
   "k": "43:1",
   "n": 1,
   "c": 43,
   "text": "حمٓ"
  },
  {
   "k": "43:2",
   "n": 2,
   "c": 43,
   "text": "وَٱلْكِتَـٰبِ ٱلْمُبِينِ"
  },
  {
   "k": "43:3",
   "n": 3,
   "c": 43,
   "text": "إِنَّا جَعَلْنَـٰهُ قُرْءَٰنًا عَرَبِيًّۭا لَّعَلَّكُمْ تَعْقِلُونَ"
  },
  {
   "k": "43:4",
   "n": 4,
   "c": 43,
   "text": "وَإِنَّهُۥ فِىٓ أُمِّ ٱلْكِتَـٰبِ لَدَيْنَا لَعَلِىٌّ حَكِيمٌ"
  },
  {
   "k": "43:5",
   "n": 5,
   "c": 43,
   "text": "أَفَنَضْرِبُ عَنكُمُ ٱلذِّكْرَ صَفْحًا أَن كُنتُمْ قَوْمًۭا مُّسْرِفِينَ"
  },
  {
   "k": "43:6",
   "n": 6,
   "c": 43,
   "text": "وَكَمْ أَرْسَلْنَا مِن نَّبِىٍّۢ فِى ٱلْأَوَّلِينَ"
  },
  {
   "k": "43:7",
   "n": 7,
   "c": 43,
   "text": "وَمَا يَأْتِيهِم مِّن نَّبِىٍّ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ"
  },
  {
   "k": "43:8",
   "n": 8,
   "c": 43,
   "text": "فَأَهْلَكْنَآ أَشَدَّ مِنْهُم بَطْشًۭا وَمَضَىٰ مَثَلُ ٱلْأَوَّلِينَ"
  },
  {
   "k": "43:9",
   "n": 9,
   "c": 43,
   "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ ٱلْعَزِيزُ ٱلْعَلِيمُ"
  },
  {
   "k": "43:10",
   "n": 10,
   "c": 43,
   "text": "ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ مَهْدًۭا وَجَعَلَ لَكُمْ فِيهَا سُبُلًۭا لَّعَلَّكُمْ تَهْتَدُونَ"
  }
 ]
}
