   "k": "75:24",
   "n": 24,
   "c": 75,
   "text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ"
  },
  {
   "k": "75:25",
   "n": 25,
   "c": 75,
   "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ"
  },
  {
   "k": "75:26",
   "n": 26,
   "c": 75,
   "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"
  },
  {
   "k": "75:27",
   "n": 27,
   "c": 75,
   "text": "وَقِيلَ مَنْ ۜ رَاقٍۢ"
  },
  {
   "k": "75:28",
   "n": 28,
   "c": 75,
   "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"
  },
  {
   "k": "75:29",
   "n": 29,
   "c": 75,
   "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"
  },
  {
   "k": "75:30",
   "n": 30,
   "c": 75,
   "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"
  },
  {
   "k": "75:31",
   "n": 31,
   "c": 75,
   "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"
  },
  {
   "k": "75:32",
   "n": 32,
   "c": 75,
   "text": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"
  },
  {
   "k": "75:33",
   "n": 33,
   "c": 75,
   "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"
  },
  {
   "k": "75:34",
   "n": 34,
   "c": 75,
   "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"
  },
  {
   "k": "75:35",
   "n": 35,
   "c": 75,
   "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"
  },
  {
   "k": "75:36",
   "n": 36,
   "c": 75,
   "text": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"
  },
  {
   "k": "75:37",
   "n": 37,
   "c": 75,
   "text": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ"
  },
  {
   "k": "75:38",
   "n": 38,
   "c": 75,
   "text": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ"
  },
  {
   "k": "75:39",
   "n": 39,
   "c": 75,
   "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"
  },
  {
   "k": "75:40",
   "n": 40,
   "c": 75,
   "text": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"
  },
  {
   "k": "76:1",
   "n": 1,
   "c": 76,
   "text": "هَلْ أَتَىٰ عَلَى ٱلْإِنسَـٰنِ حِينٌۭ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًۭٔا مَّذْكُورًا"
  },
  {
   "k": "76:2",
   "n": 2,
   "c": 76,
   "text": "إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍۢ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا"
  },
  {
   "k": "76:3",
   "n": 3,
   "c": 76,
   "text": "إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًۭا وَإِمَّا كَفُورًا"
  },
  {
   "k": "76:4",
   "n": 4,
   "c": 76,
   "text": "إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًۭا وَسَعِيرًا"
  },
  {
   "k": "76:5",
   "n": 5,
   "c": 76,
   "text": "إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍۢ كَانَ مِزَاجُهَا كَافُورًا"
  }
 ]
}
