 "verses": [
  {
   "k": "50:1",
   "n": 1,
   "c": 50,
   "text": "قٓ ۚ وَٱلْقُرْءَانِ ٱلْمَجِيدِ"
  },
  {
   "k": "50:2",
   "n": 2,
   "c": 50,
   "text": "بَلْ عَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌۭ مِّنْهُمْ فَقَالَ ٱلْكَـٰفِرُونَ هَـٰذَا شَىْءٌ عَجِيبٌ"
  },
  {
   "k": "50:3",
   "n": 3,
   "c": 50,
   "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا ۖ ذَٰلِكَ رَجْعٌۢ بَعِيدٌۭ"
  },
  {
   "k": "50:4",
   "n": 4,
   "c": 50,
   "text": "قَدْ عَلِمْنَا مَا تَنقُصُ ٱلْأَرْضُ مِنْهُمْ ۖ وَعِندَنَا كِتَـٰبٌ حَفِيظٌۢ"
  },
  {
   "k": "50:5",
   "n": 5,
   "c": 50,
   "text": "بَلْ كَذَّبُوا۟ بِٱلْحَقِّ لَمَّا جَآءَهُمْ فَهُمْ فِىٓ أَمْرٍۢ مَّرِيجٍ"
  },
  {
   "k": "50:6",
   "n": 6,
   "c": 50,
   "text": "أَفَلَمْ يَنظُرُوٓا۟ إِلَى ٱلسَّمَآءِ فَوْقَهُمْ كَيْفَ بَنَيْنَـٰهَا وَزَيَّنَّـٰهَا وَمَا لَهَا مِن فُرُوجٍۢ"
  },
  {
   "k": "50:7",
   "n": 7,
   "c": 50,
   "text": "وَٱلْأَرْضَ مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍۭ بَهِيجٍۢ"
  },
  {
   "k": "50:8",
   "n": 8,
   "c": 50,
   "text": "تَبْصِرَةًۭ وَذِكْرَىٰ لِكُلِّ عَبْدٍۢ مُّنِيبٍۢ"
  },
  {
   "k": "50:9",
   "n": 9,
   "c": 50,
   "text": "وَنَزَّلْنَا مِنَ ٱلسَّمَآءِ مَآءًۭ مُّبَـٰرَكًۭا فَأَنۢبَتْنَا بِهِۦ جَنَّـٰتٍۢ وَحَبَّ ٱلْحَصِيدِ"
  },
  {
   "k": "50:10",
   "n": 10,
   "c": 50,
   "text": "وَٱلنَّخْلَ بَاسِقَـٰتٍۢ لَّهَا طَلْعٌۭ نَّضِيدٌۭ"
  },
  {
   "k": "50:11",
   "n": 11,
   "c": 50,
   "text": "رِّزْقًۭا لِّلْعِبَادِ ۖ وَأَحْيَيْنَا بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ كَذَٰلِكَ ٱلْخُرُوجُ"
  },
  {
   "k": "50:12",
   "n": 12,
   "c": 50,
   "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍۢ وَأَصْحَـٰبُ ٱلرَّسِّ وَثَمُودُ"
  },
  {
   "k": "50:13",
   "n": 13,
   "c": 50,
   "text": "وَعَادٌۭ وَفِرْعَوْنُ وَإِخْوَٰنُ لُوطٍۢ"
  },
  {
   "k": "50:14",
   "n": 14,
   "c": 50,
