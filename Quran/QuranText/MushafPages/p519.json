 "verses": [
  {
   "k": "50:16",
   "n": 16,
   "c": 50,
   "text": "وَلَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ وَنَعْلَمُ مَا تُوَسْوِسُ بِهِۦ نَفْسُهُۥ ۖ وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ ٱلْوَرِيدِ"
  },
  {
   "k": "50:17",
   "n": 17,
   "c": 50,
   "text": "إِذْ يَتَلَقَّى ٱلْمُتَلَقِّيَانِ عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٌۭ"
  },
  {
   "k": "50:18",
   "n": 18,
   "c": 50,
   "text": "مَّا يَلْفِظُ مِن قَوْلٍ إِلَّا لَدَيْهِ رَقِيبٌ عَتِيدٌۭ"
  },
  {
   "k": "50:19",
   "n": 19,
   "c": 50,
   "text": "وَجَآءَتْ سَكْرَةُ ٱلْمَوْتِ بِٱلْحَقِّ ۖ ذَٰلِكَ مَا كُنتَ مِنْهُ تَحِيدُ"
  },
  {
   "k": "50:20",
   "n": 20,
   "c": 50,
   "text": "وَنُفِخَ فِى ٱلصُّورِ ۚ ذَٰلِكَ يَوْمُ ٱلْوَعِيدِ"
  },
  {
   "k": "50:21",
   "n": 21,
   "c": 50,
   "text": "وَجَآءَتْ كُلُّ نَفْسٍۢ مَّعَهَا سَآئِقٌۭ وَشَهِيدٌۭ"
  },
  {
   "k": "50:22",
   "n": 22,
   "c": 50,
   "text": "لَّقَدْ كُنتَ فِى غَفْلَةٍۢ مِّنْ هَـٰذَا فَكَشَفْنَا عَنكَ غِطَآءَكَ فَبَصَرُكَ ٱلْيَوْمَ حَدِيدٌۭ"
  },
  {
   "k": "50:23",
   "n": 23,
   "c": 50,
   "text": "وَقَالَ قَرِينُهُۥ هَـٰذَا مَا لَدَىَّ عَتِيدٌ"
  },
  {
   "k": "50:24",
   "n": 24,
   "c": 50,
   "text": "أَلْقِيَا فِى جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٍۢ"
  },
  {
   "k": "50:25",
   "n": 25,
   "c": 50,
   "text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍۢ مُّرِيبٍ"
  },
  {
   "k": "50:26",
   "n": 26,
   "c": 50,
   "text": "ٱلَّذِى جَعَلَ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ فَأَلْقِيَاهُ فِى ٱلْعَذَابِ ٱلشَّدِيدِ"
  },
  {
   "k": "50:27",
   "n": 27,
   "c": 50,
   "text": "۞ قَالَ قَرِينُهُۥ رَبَّنَا مَآ أَطْغَيْتُهُۥ وَلَـٰكِن كَانَ فِى ضَلَـٰلٍۭ بَعِيدٍۢ"
  },
  {
   "k": "50:28",
   "n": 28,
   "c": 50,
   "text": "قَالَ لَا تَخْتَصِمُوا۟ لَدَىَّ وَقَدْ قَدَّمْتُ إِلَيْكُم بِٱلْوَعِيدِ"
  },
  {
   "k": "50:29",
   "n": 29,
   "c": 50,
   "text": "مَا يُبَدَّلُ ٱلْقَوْلُ لَدَىَّ وَمَآ أَنَا۠ بِظَلَّـٰمٍۢ لِّلْعَبِيدِ"
  },
  {
   "k": "50:30",
   "n": 30,
   "c": 50,
   "text": "يَوْمَ نَقُولُ لِجَهَنَّمَ هَلِ ٱمْتَلَأْتِ وَتَقُولُ هَلْ مِن مَّزِيدٍۢ"
  },
  {
   "k": "50:31",
   "n": 31,
   "c": 50,
   "text": "وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ بَعِيدٍ"
  },
  {
   "k": "50:32",
   "n": 32,
   "c": 50,
   "text": "هَـٰذَا مَا تُوعَدُونَ لِكُلِّ أَوَّابٍ حَفِيظٍۢ"
  },
  {
   "k": "50:33",
   "n": 33,
   "c": 50,
   "text": "مَّنْ خَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ وَجَآءَ بِقَلْبٍۢ مُّنِيبٍ"
  },
  {
   "k": "50:34",
   "n": 34,
   "c": 50,
   "text": "ٱدْخُلُوهَا بِسَلَـٰمٍۢ ۖ ذَٰلِكَ يَوْمُ ٱلْخُلُودِ"
  },
  {
   "k": "50:35",
   "n": 35,
   "c": 50,
   "text": "لَهُم مَّا يَشَآءُونَ فِيهَا وَلَدَيْنَا مَزِيدٌۭ"
  }
 ]
}
