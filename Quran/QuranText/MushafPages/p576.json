 "verses": [
  {
   "k": "74:18",
   "n": 18,
   "c": 74,
   "text": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ"
  },
  {
   "k": "74:19",
   "n": 19,
   "c": 74,
   "text": "فَقُتِلَ كَيْفَ قَدَّرَ"
  },
  {
   "k": "74:20",
   "n": 20,
   "c": 74,
   "text": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ"
  },
  {
   "k": "74:21",
   "n": 21,
   "c": 74,
   "text": "ثُمَّ نَظَرَ"
  },
  {
   "k": "74:22",
   "n": 22,
   "c": 74,
   "text": "ثُمَّ عَبَسَ وَبَسَرَ"
  },
  {
   "k": "74:23",
   "n": 23,
   "c": 74,
   "text": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ"
  },
  {
   "k": "74:24",
   "n": 24,
   "c": 74,
   "text": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ"
  },
  {
   "k": "74:25",
   "n": 25,
   "c": 74,
   "text": "إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ"
  },
  {
   "k": "74:26",
   "n": 26,
   "c": 74,
   "text": "سَأُصْلِيهِ سَقَرَ"
  },
  {
   "k": "74:27",
   "n": 27,
   "c": 74,
   "text": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ"
  },
  {
   "k": "74:28",
   "n": 28,
   "c": 74,
   "text": "لَا تُبْقِى وَلَا تَذَرُ"
  },
  {
   "k": "74:29",
   "n": 29,
   "c": 74,
   "text": "لَوَّاحَةٌۭ لِّلْبَشَرِ"
  },
  {
   "k": "74:30",
   "n": 30,
   "c": 74,
   "text": "عَلَيْهَا تِسْعَةَ عَشَرَ"
  },
  {
   "k": "74:31",
   "n": 31,
   "c": 74,
   "text": "وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ"
  },
  {
   "k": "74:32",
   "n": 32,
   "c": 74,
   "text": "كَلَّا وَٱلْقَمَرِ"
  },
  {
   "k": "74:33",
   "n": 33,
   "c": 74,
   "text": "وَٱلَّيْلِ إِذْ أَدْبَرَ"
  },
  {
   "k": "74:34",
   "n": 34,
   "c": 74,
   "text": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ"
  },
  {
   "k": "74:35",
   "n": 35,
   "c": 74,
   "text": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ"
  },
  {
   "k": "74:36",
   "n": 36,
   "c": 74,
   "text": "نَذِيرًۭا لِّلْبَشَرِ"
  },
  {
   "k": "74:37",
   "n": 37,
   "c": 74,
   "text": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ"
  },
  {
   "k": "74:38",
   "n": 38,
   "c": 74,
   "text": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ"
  },
  {
   "k": "74:39",
   "n": 39,
   "c": 74,
   "text": "إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ"
  },
  {
   "k": "74:40",
   "n": 40,
   "c": 74,
   "text": "فِى جَنَّـٰتٍۢ يَتَسَآءَلُونَ"
  },
  {
   "k": "74:41",
   "n": 41,
   "c": 74,
   "text": "عَنِ ٱلْمُجْرِمِينَ"
  },
  {
   "k": "74:42",
   "n": 42,
   "c": 74,
   "text": "مَا سَلَكَكُمْ فِى سَقَرَ"
  },
  {
   "k": "74:43",
   "n": 43,
   "c": 74,
   "text": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ"
  },
  {
   "k": "74:44",
   "n": 44,
   "c": 74,
   "text": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ"
  },
  {
   "k": "74:45",
   "n": 45,
   "c": 74,
   "text": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ"
  },
  {
   "k": "74:46",
   "n": 46,
   "c": 74,
   "text": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ"
  },
  {
   "k": "74:47",
   "n": 47,
   "c": 74,
   "text": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ"
  }
 ]
}
