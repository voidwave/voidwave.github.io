 "verses": [
  {
   "k": "76:26",
   "n": 26,
   "c": 76,
   "text": "وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًۭا طَوِيلًا"
  },
  {
   "k": "76:27",
   "n": 27,
   "c": 76,
   "text": "إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا ثَقِيلًۭا"
  },
  {
   "k": "76:28",
   "n": 28,
   "c": 76,
   "text": "نَّحْنُ خَلَقْنَـٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَـٰلَهُمْ تَبْدِيلًا"
  },
  {
   "k": "76:29",
   "n": 29,
   "c": 76,
   "text": "إِنَّ هَـٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًۭا"
  },
  {
   "k": "76:30",
   "n": 30,
   "c": 76,
   "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًۭا"
  },
  {
   "k": "76:31",
   "n": 31,
   "c": 76,
   "text": "يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا"
  },
  {
   "k": "77:1",
   "n": 1,
   "c": 77,
   "text": "وَٱلْمُرْسَلَـٰتِ عُرْفًۭا"
  },
  {
   "k": "77:2",
   "n": 2,
   "c": 77,
   "text": "فَٱلْعَـٰصِفَـٰتِ عَصْفًۭا"
  },
  {
   "k": "77:3",
   "n": 3,
   "c": 77,
   "text": "وَٱلنَّـٰشِرَٰتِ نَشْرًۭا"
  },
  {
   "k": "77:4",
   "n": 4,
   "c": 77,
   "text": "فَٱلْفَـٰرِقَـٰتِ فَرْقًۭا"
  },
  {
   "k": "77:5",
   "n": 5,
   "c": 77,
   "text": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا"
  },
  {
   "k": "77:6",
   "n": 6,
   "c": 77,
   "text": "عُذْرًا أَوْ نُذْرًا"
  },
  {
   "k": "77:7",
   "n": 7,
   "c": 77,
   "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ"
  },
  {
   "k": "77:8",
   "n": 8,
   "c": 77,
   "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ"
  },
  {
   "k": "77:9",
   "n": 9,
   "c": 77,
   "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"
  },
  {
   "k": "77:10",
   "n": 10,
   "c": 77,
   "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ"
  },
  {
   "k": "77:11",
   "n": 11,
   "c": 77,
   "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"
  },
  {
   "k": "77:12",
   "n": 12,
   "c": 77,
   "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ"
  },
  {
   "k": "77:13",
   "n": 13,
   "c": 77,
   "text": "لِيَوْمِ ٱلْفَصْلِ"
  },
  {
   "k": "77:14",
   "n": 14,
   "c": 77,
   "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"
  },
  {
   "k": "77:15",
   "n": 15,
   "c": 77,
   "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ"
  },
  {
   "k": "77:16",
   "n": 16,
   "c": 77,
   "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"
  },
  {
   "k": "77:17",
   "n": 17,
   "c": 77,
   "text": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"
  },
  {
