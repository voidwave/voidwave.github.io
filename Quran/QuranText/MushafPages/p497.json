 ],
 "verses": [
  {
   "k": "44:19",
   "n": 19,
   "c": 44,
   "text": "وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَـٰنٍۢ مُّبِينٍۢ"
  },
  {
   "k": "44:20",
   "n": 20,
   "c": 44,
   "text": "وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ"
  },
  {
   "k": "44:21",
   "n": 21,
   "c": 44,
   "text": "وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ"
  },
  {
   "k": "44:22",
   "n": 22,
   "c": 44,
   "text": "فَدَعَا رَبَّهُۥٓ أَنَّ هَـٰٓؤُلَآءِ قَوْمٌۭ مُّجْرِمُونَ"
  },
  {
   "k": "44:23",
   "n": 23,
   "c": 44,
   "text": "فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ"
  },
  {
   "k": "44:24",
   "n": 24,
   "c": 44,
   "text": "وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌۭ مُّغْرَقُونَ"
  },
  {
   "k": "44:25",
   "n": 25,
   "c": 44,
   "text": "كَمْ تَرَكُوا۟ مِن جَنَّـٰتٍۢ وَعُيُونٍۢ"
  },
  {
   "k": "44:26",
   "n": 26,
   "c": 44,
   "text": "وَزُرُوعٍۢ وَمَقَامٍۢ كَرِيمٍۢ"
  },
  {
   "k": "44:27",
   "n": 27,
   "c": 44,
   "text": "وَنَعْمَةٍۢ كَانُوا۟ فِيهَا فَـٰكِهِينَ"
  },
  {
   "k": "44:28",
   "n": 28,
   "c": 44,
   "text": "كَذَٰلِكَ ۖ وَأَوْرَثْنَـٰهَا قَوْمًا ءَاخَرِينَ"
  },
  {
   "k": "44:29",
   "n": 29,
   "c": 44,
   "text": "فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ"
  },
  {
   "k": "44:30",
   "n": 30,
   "c": 44,
   "text": "وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ"
  },
  {
   "k": "44:31",
   "n": 31,
   "c": 44,
   "text": "مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًۭا مِّنَ ٱلْمُسْرِفِينَ"
  },
  {
   "k": "44:32",
   "n": 32,
   "c": 44,
   "text": "وَلَقَدِ ٱخْتَرْنَـٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَـٰلَمِينَ"
  },
  {
   "k": "44:33",
   "n": 33,
   "c": 44,
   "text": "وَءَاتَيْنَـٰهُم مِّنَ ٱلْـَٔايَـٰتِ مَا فِيهِ بَلَـٰٓؤٌۭا۟ مُّبِينٌ"
  },
  {
   "k": "44:34",
   "n": 34,
   "c": 44,
   "text": "إِنَّ هَـٰٓؤُلَآءِ لَيَقُولُونَ"
  },
  {
   "k": "44:35",
   "n": 35,
   "c": 44,
   "text": "إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ"
  },
  {
   "k": "44:36",
   "n": 36,
   "c": 44,
   "text": "فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَـٰدِقِينَ"
  },
  {
   "k": "44:37",
   "n": 37,
   "c": 44,
   "text": "أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍۢ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَـٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ"
  },
  {
   "k": "44:38",
   "n": 38,
   "c": 44,
   "text": "وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَـٰعِبِينَ"
  },
  {
   "k": "44:39",
   "n": 39,
   "c": 44,
   "text": "مَا خَلَقْنَـٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ"
  }
 ]
