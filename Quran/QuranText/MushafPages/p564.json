 "verses": [
  {
   "k": "67:27",
   "n": 27,
   "c": 67,
   "text": "فَلَمَّا رَأَوْهُ زُلْفَةًۭ سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تَدَّعُونَ"
  },
  {
   "k": "67:28",
   "n": 28,
   "c": 67,
   "text": "قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ ٱللَّهُ وَمَن مَّعِىَ أَوْ رَحِمَنَا فَمَن يُجِيرُ ٱلْكَـٰفِرِينَ مِنْ عَذَابٍ أَلِيمٍۢ"
  },
  {
   "k": "67:29",
   "n": 29,
   "c": 67,
   "text": "قُلْ هُوَ ٱلرَّحْمَـٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَـٰلٍۢ مُّبِينٍۢ"
  },
  {
   "k": "67:30",
   "n": 30,
   "c": 67,
   "text": "قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْرًۭا فَمَن يَأْتِيكُم بِمَآءٍۢ مَّعِينٍۭ"
  },
  {
   "k": "68:1",
   "n": 1,
   "c": 68,
   "text": "نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ"
  },
  {
   "k": "68:2",
   "n": 2,
   "c": 68,
   "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ"
  },
  {
   "k": "68:3",
   "n": 3,
   "c": 68,
   "text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ"
  },
  {
   "k": "68:4",
   "n": 4,
   "c": 68,
   "text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ"
  },
  {
   "k": "68:5",
   "n": 5,
   "c": 68,
   "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ"
  },
  {
   "k": "68:6",
   "n": 6,
   "c": 68,
   "text": "بِأَييِّكُمُ ٱلْمَفْتُونُ"
  },
  {
   "k": "68:7",
   "n": 7,
   "c": 68,
   "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ"
  },
  {
   "k": "68:8",
   "n": 8,
   "c": 68,
   "text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ"
  },
  {
   "k": "68:9",
   "n": 9,
   "c": 68,
   "text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ"
  },
  {
   "k": "68:10",
   "n": 10,
   "c": 68,
   "text": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ"
  },
  {
   "k": "68:11",
   "n": 11,
   "c": 68,
   "text": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ"
  },
  {
   "k": "68:12",
   "n": 12,
   "c": 68,
   "text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ"
  },
  {
   "k": "68:13",
   "n": 13,
   "c": 68,
   "text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ"
  },
  {
   "k": "68:14",
   "n": 14,
   "c": 68,
   "text": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ"
  },
  {
   "k": "68:15",
   "n": 15,
   "c": 68,
   "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ"
  },
  {
   "k": "68:16",
   "n": 16,
   "c": 68,
   "text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ"
  }
 ]
