 "verses": [
  {
   "k": "78:31",
   "n": 31,
   "c": 78,
   "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا"
  },
  {
   "k": "78:32",
   "n": 32,
   "c": 78,
   "text": "حَدَآئِقَ وَأَعْنَـٰبًۭا"
  },
  {
   "k": "78:33",
   "n": 33,
   "c": 78,
   "text": "وَكَوَاعِبَ أَتْرَابًۭا"
  },
  {
   "k": "78:34",
   "n": 34,
   "c": 78,
   "text": "وَكَأْسًۭا دِهَاقًۭا"
  },
  {
   "k": "78:35",
   "n": 35,
   "c": 78,
   "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا"
  },
  {
   "k": "78:36",
   "n": 36,
   "c": 78,
   "text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا"
  },
  {
   "k": "78:37",
   "n": 37,
   "c": 78,
   "text": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا"
  },
  {
   "k": "78:38",
   "n": 38,
   "c": 78,
   "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًۭا"
  },
  {
   "k": "78:39",
   "n": 39,
   "c": 78,
   "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"
  },
  {
   "k": "78:40",
   "n": 40,
   "c": 78,
   "text": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا"
  },
  {
   "k": "79:1",
   "n": 1,
   "c": 79,
   "text": "وَٱلنَّـٰزِعَـٰتِ غَرْقًۭا"
  },
  {
   "k": "79:2",
   "n": 2,
   "c": 79,
   "text": "وَٱلنَّـٰشِطَـٰتِ نَشْطًۭا"
  },
  {
   "k": "79:3",
   "n": 3,
   "c": 79,
   "text": "وَٱلسَّـٰبِحَـٰتِ سَبْحًۭا"
  },
  {
   "k": "79:4",
   "n": 4,
   "c": 79,
   "text": "فَٱلسَّـٰبِقَـٰتِ سَبْقًۭا"
  },
  {
   "k": "79:5",
   "n": 5,
   "c": 79,
   "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا"
  },
  {
   "k": "79:6",
   "n": 6,
   "c": 79,
   "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"
  },
  {
   "k": "79:7",
   "n": 7,
   "c": 79,
   "text": "تَتْبَعُهَا ٱلرَّادِفَةُ"
  },
  {
   "k": "79:8",
   "n": 8,
   "c": 79,
   "text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ"
  },
  {
   "k": "79:9",
   "n": 9,
   "c": 79,
   "text": "أَبْصَـٰرُهَا خَـٰشِعَةٌۭ"
  },
  {
   "k": "79:10",
   "n": 10,
   "c": 79,
   "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"
  },
  {
   "k": "79:11",
   "n": 11,
   "c": 79,
   "text": "أَءِذَا كُنَّا عِظَـٰمًۭا نَّخِرَةًۭ"
  },
  {
   "k": "79:12",
   "n": 12,
   "c": 79,
   "text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ"
  },
  {
   "k": "79:13",
   "n": 13,
   "c": 79,
   "text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ"
  },
  {
   "k": "79:14",
   "n": 14,
   "c": 79,
   "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ"
  },
  {
   "k": "79:15",
   "n": 15,
   "c": 79,
   "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"
  },
  {
   "k": "79:16",
   "n": 16,
   "c": 79,
   "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"
  }
 ]
}
