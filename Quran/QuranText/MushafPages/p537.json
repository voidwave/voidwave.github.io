 "verses": [
  {
   "k": "56:77",
   "n": 77,
   "c": 56,
   "text": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ"
  },
  {
   "k": "56:78",
   "n": 78,
   "c": 56,
   "text": "فِى كِتَـٰبٍۢ مَّكْنُونٍۢ"
  },
  {
   "k": "56:79",
   "n": 79,
   "c": 56,
   "text": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"
  },
  {
   "k": "56:80",
   "n": 80,
   "c": 56,
   "text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"
  },
  {
   "k": "56:81",
   "n": 81,
   "c": 56,
   "text": "أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"
  },
  {
   "k": "56:82",
   "n": 82,
   "c": 56,
   "text": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"
  },
  {
   "k": "56:83",
   "n": 83,
   "c": 56,
   "text": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"
  },
  {
   "k": "56:84",
   "n": 84,
   "c": 56,
   "text": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ"
  },
  {
   "k": "56:85",
   "n": 85,
   "c": 56,
   "text": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ"
  },
  {
   "k": "56:86",
   "n": 86,
   "c": 56,
   "text": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"
  },
  {
   "k": "56:87",
   "n": 87,
   "c": 56,
   "text": "تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ"
  },
  {
   "k": "56:88",
   "n": 88,
   "c": 56,
   "text": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"
  },
  {
   "k": "56:89",
   "n": 89,
   "c": 56,
   "text": "فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ"
  },
  {
   "k": "56:90",
   "n": 90,
   "c": 56,
   "text": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"
  },
  {
   "k": "56:91",
   "n": 91,
   "c": 56,
   "text": "فَسَلَـٰمٌۭ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"
  },
  {
   "k": "56:92",
   "n": 92,
   "c": 56,
   "text": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"
  },
  {
   "k": "56:93",
   "n": 93,
   "c": 56,
   "text": "فَنُزُلٌۭ مِّنْ حَمِيمٍۢ"
  },
  {
   "k": "56:94",
   "n": 94,
   "c": 56,
   "text": "وَتَصْلِيَةُ جَحِيمٍ"
  },
  {
   "k": "56:95",
   "n": 95,
   "c": 56,
   "text": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"
  },
  {
   "k": "56:96",
   "n": 96,
   "c": 56,
