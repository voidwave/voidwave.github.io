 "verses": [
  {
   "k": "84:25",
   "n": 25,
   "c": 84,
   "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"
  },
  {
   "k": "85:1",
   "n": 1,
   "c": 85,
   "text": "وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ"
  },
  {
   "k": "85:2",
   "n": 2,
   "c": 85,
   "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ"
  },
  {
   "k": "85:3",
   "n": 3,
   "c": 85,
   "text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ"
  },
  {
   "k": "85:4",
   "n": 4,
   "c": 85,
   "text": "قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ"
  },
  {
   "k": "85:5",
   "n": 5,
   "c": 85,
   "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ"
  },
  {
   "k": "85:6",
   "n": 6,
   "c": 85,
   "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ"
  },
  {
   "k": "85:7",
   "n": 7,
   "c": 85,
   "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ"
  },
  {
   "k": "85:8",
   "n": 8,
   "c": 85,
   "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ"
  },
  {
   "k": "85:9",
   "n": 9,
   "c": 85,
   "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ"
  },
  {
   "k": "85:10",
   "n": 10,
   "c": 85,
   "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ"
  },
  {
   "k": "85:11",
   "n": 11,
   "c": 85,
   "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ"
  },
  {
   "k": "85:12",
   "n": 12,
   "c": 85,
   "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ"
  },
  {
   "k": "85:13",
   "n": 13,
   "c": 85,
   "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ"
  },
  {
   "k": "85:14",
   "n": 14,
   "c": 85,
   "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ"
  },
  {
   "k": "85:15",
   "n": 15,
   "c": 85,
   "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ"
  },
  {
   "k": "85:16",
   "n": 16,
   "c": 85,
   "text": "فَعَّالٌۭ لِّمَا يُرِيدُ"
  },
  {
   "k": "85:17",
   "n": 17,
   "c": 85,
   "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ"
  },
  {
   "k": "85:18",
   "n": 18,
   "c": 85,
   "text": "فِرْعَوْنَ وَثَمُودَ"
  },
  {
   "k": "85:19",
   "n": 19,
   "c": 85,
   "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ"
  },
  {
   "k": "85:20",
   "n": 20,
   "c": 85,
   "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ"
  },
  {
   "k": "85:21",
   "n": 21,
   "c": 85,
   "text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ"
  },
  {
   "k": "85:22",
   "n": 22,
   "c": 85,
   "text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ"
  }
 ]
}
