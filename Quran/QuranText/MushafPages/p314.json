 "verses": [
  {
   "k": "20:38",
   "n": 38,
   "c": 20,
   "text": "إِذْ أَوْحَيْنَآ إِلَىٰٓ أُمِّكَ مَا يُوحَىٰٓ"
  },
  {
   "k": "20:39",
   "n": 39,
   "c": 20,
   "text": "أَنِ ٱقْذِفِيهِ فِى ٱلتَّابُوتِ فَٱقْذِفِيهِ فِى ٱلْيَمِّ فَلْيُلْقِهِ ٱلْيَمُّ بِٱلسَّاحِلِ يَأْخُذْهُ عَدُوٌّۭ لِّى وَعَدُوٌّۭ لَّهُۥ ۚ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّةًۭ مِّنِّى وَلِتُصْنَعَ عَلَىٰ عَيْنِىٓ"
  },
  {
   "k": "20:40",
   "n": 40,
   "c": 20,
   "text": "إِذْ تَمْشِىٓ أُخْتُكَ فَتَقُولُ هَلْ أَدُلُّكُمْ عَلَىٰ مَن يَكْفُلُهُۥ ۖ فَرَجَعْنَـٰكَ إِلَىٰٓ أُمِّكَ كَىْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ ۚ وَقَتَلْتَ نَفْسًۭا فَنَجَّيْنَـٰكَ مِنَ ٱلْغَمِّ وَفَتَنَّـٰكَ فُتُونًۭا ۚ فَلَبِثْتَ سِنِينَ فِىٓ أَهْلِ مَدْيَنَ ثُمَّ جِئْتَ عَلَىٰ قَدَرٍۢ يَـٰمُوسَىٰ"
  },
  {
   "k": "20:41",
   "n": 41,
   "c": 20,
   "text": "وَٱصْطَنَعْتُكَ لِنَفْسِى"
  },
  {
   "k": "20:42",
   "n": 42,
   "c": 20,
   "text": "ٱذْهَبْ أَنتَ وَأَخُوكَ بِـَٔايَـٰتِى وَلَا تَنِيَا فِى ذِكْرِى"
  },
  {
   "k": "20:43",
   "n": 43,
   "c": 20,
   "text": "ٱذْهَبَآ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"
  },
  {
   "k": "20:44",
   "n": 44,
   "c": 20,
   "text": "فَقُولَا لَهُۥ قَوْلًۭا لَّيِّنًۭا لَّعَلَّهُۥ يَتَذَكَّرُ أَوْ يَخْشَىٰ"
  },
  {
   "k": "20:45",
   "n": 45,
   "c": 20,
   "text": "قَالَا رَبَّنَآ إِنَّنَا نَخَافُ أَن يَفْرُطَ عَلَيْنَآ أَوْ أَن يَطْغَىٰ"
  },
  {
   "k": "20:46",
   "n": 46,
   "c": 20,
   "text": "قَالَ لَا تَخَافَآ ۖ إِنَّنِى مَعَكُمَآ أَسْمَعُ وَأَرَىٰ"
  },
  {
   "k": "20:47",
   "n": 47,
   "c": 20,
   "text": "فَأْتِيَاهُ فَقُولَآ إِنَّا رَسُولَا رَبِّكَ فَأَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ وَلَا تُعَذِّبْهُمْ ۖ قَدْ جِئْنَـٰكَ بِـَٔايَةٍۢ مِّن رَّبِّكَ ۖ وَٱلسَّلَـٰمُ عَلَىٰ مَنِ ٱتَّبَعَ ٱلْهُدَىٰٓ"
  },
  {
   "k": "20:48",
   "n": 48,
   "c": 20,
   "text": "إِنَّا قَدْ أُوحِىَ إِلَيْنَآ أَنَّ ٱلْعَذَابَ عَلَىٰ مَن كَذَّبَ وَتَوَلَّىٰ"
  },
  {
   "k": "20:49",
   "n": 49,
   "c": 20,
   "text": "قَالَ فَمَن رَّبُّكُمَا يَـٰمُوسَىٰ"
  },
  {
   "k": "20:50",
   "n": 50,
   "c": 20,
   "text": "قَالَ رَبُّنَا ٱلَّذِىٓ أَعْطَىٰ كُلَّ شَىْءٍ خَلْقَهُۥ ثُمَّ هَدَىٰ"
  },
  {
   "k": "20:51",
   "n": 51,
   "c": 20,
   "text": "قَالَ فَمَا بَالُ ٱلْقُرُونِ ٱلْأُولَىٰ"
  }
 ]
}
