 "verses": [
  {
   "k": "51:31",
   "n": 31,
   "c": 51,
   "text": "۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ"
  },
  {
   "k": "51:32",
   "n": 32,
   "c": 51,
   "text": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ"
  },
  {
   "k": "51:33",
   "n": 33,
   "c": 51,
   "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةًۭ مِّن طِينٍۢ"
  },
  {
   "k": "51:34",
   "n": 34,
   "c": 51,
   "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ"
  },
  {
   "k": "51:35",
   "n": 35,
   "c": 51,
   "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ"
  },
  {
   "k": "51:36",
   "n": 36,
   "c": 51,
   "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍۢ مِّنَ ٱلْمُسْلِمِينَ"
  },
  {
   "k": "51:37",
   "n": 37,
   "c": 51,
   "text": "وَتَرَكْنَا فِيهَآ ءَايَةًۭ لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ"
  },
  {
   "k": "51:38",
   "n": 38,
   "c": 51,
   "text": "وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَـٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَـٰنٍۢ مُّبِينٍۢ"
  },
  {
   "k": "51:39",
   "n": 39,
   "c": 51,
   "text": "فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَـٰحِرٌ أَوْ مَجْنُونٌۭ"
  },
  {
   "k": "51:40",
   "n": 40,
   "c": 51,
   "text": "فَأَخَذْنَـٰهُ وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌۭ"
  },
  {
   "k": "51:41",
   "n": 41,
   "c": 51,
   "text": "وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ"
  },
  {
   "k": "51:42",
   "n": 42,
   "c": 51,
   "text": "مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ"
  },
  {
   "k": "51:43",
   "n": 43,
   "c": 51,
   "text": "وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍۢ"
  },
  {
   "k": "51:44",
   "n": 44,
   "c": 51,
   "text": "فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ وَهُمْ يَنظُرُونَ"
  },
  {
   "k": "51:45",
   "n": 45,
   "c": 51,
   "text": "فَمَا ٱسْتَطَـٰعُوا۟ مِن قِيَامٍۢ وَمَا كَانُوا۟ مُنتَصِرِينَ"
  },
  {
   "k": "51:46",
   "n": 46,
   "c": 51,
   "text": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًۭا فَـٰسِقِينَ"
  },
  {
   "k": "51:47",
   "n": 47,
   "c": 51,
   "text": "وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍۢ وَإِنَّا لَمُوسِعُونَ"
  },
  {
   "k": "51:48",
   "n": 48,
   "c": 51,
   "text": "وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ"
  },
  {
   "k": "51:49",
   "n": 49,
   "c": 51,
   "text": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ"
  },
  {
   "k": "51:50",
   "n": 50,
   "c": 51,
   "text": "فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ"
  },
  {
   "k": "51:51",
   "n": 51,
   "c": 51,
   "text": "وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ"
  }
 ]
}
