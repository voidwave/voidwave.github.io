 "verses": [
  {
   "k": "15:1",
   "n": 1,
   "c": 15,
   "text": "الٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ وَقُرْءَانٍۢ مُّبِينٍۢ"
  },
  {
   "k": "15:2",
   "n": 2,
   "c": 15,
   "text": "رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ لَوْ كَانُوا۟ مُسْلِمِينَ"
  },
  {
   "k": "15:3",
   "n": 3,
   "c": 15,
   "text": "ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُ ۖ فَسَوْفَ يَعْلَمُونَ"
  },
  {
   "k": "15:4",
   "n": 4,
   "c": 15,
   "text": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌۭ مَّعْلُومٌۭ"
  },
  {
   "k": "15:5",
   "n": 5,
   "c": 15,
   "text": "مَّا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ"
  },
  {
   "k": "15:6",
   "n": 6,
   "c": 15,
   "text": "وَقَالُوا۟ يَـٰٓأَيُّهَا ٱلَّذِى نُزِّلَ عَلَيْهِ ٱلذِّكْرُ إِنَّكَ لَمَجْنُونٌۭ"
  },
  {
   "k": "15:7",
   "n": 7,
   "c": 15,
   "text": "لَّوْ مَا تَأْتِينَا بِٱلْمَلَـٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"
  },
  {
   "k": "15:8",
   "n": 8,
   "c": 15,
   "text": "مَا نُنَزِّلُ ٱلْمَلَـٰٓئِكَةَ إِلَّا بِٱلْحَقِّ وَمَا كَانُوٓا۟ إِذًۭا مُّنظَرِينَ"
  },
  {
   "k": "15:9",
   "n": 9,
   "c": 15,
   "text": "إِنَّا نَحْنُ نَزَّلْنَا ٱلذِّكْرَ وَإِنَّا لَهُۥ لَحَـٰفِظُونَ"
  },
  {
   "k": "15:10",
   "n": 10,
   "c": 15,
   "text": "وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِى شِيَعِ ٱلْأَوَّلِينَ"
  },
  {
   "k": "15:11",
   "n": 11,
   "c": 15,
   "text": "وَمَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ"
  },
  {
   "k": "15:12",
   "n": 12,
   "c": 15,
   "text": "كَذَٰلِكَ نَسْلُكُهُۥ فِى قُلُوبِ ٱلْمُجْرِمِينَ"
  },
  {
   "k": "15:13",
   "n": 13,
   "c": 15,
   "text": "لَا يُؤْمِنُونَ بِهِۦ ۖ وَقَدْ خَلَتْ سُنَّةُ ٱلْأَوَّلِينَ"
  },
  {
   "k": "15:14",
   "n": 14,
   "c": 15,
   "text": "وَلَوْ فَتَحْنَا عَلَيْهِم بَابًۭا مِّنَ ٱلسَّمَآءِ فَظَلُّوا۟ فِيهِ يَعْرُجُونَ"
  },
  {
   "k": "15:15",
   "n": 15,
   "c": 15,
   "text": "لَقَالُوٓا۟ إِنَّمَا سُكِّرَتْ أَبْصَـٰرُنَا بَلْ نَحْنُ قَوْمٌۭ مَّسْحُورُونَ"
  }
 ]
}
