   "n": 17,
   "c": 52,
   "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍۢ وَنَعِيمٍۢ"
  },
  {
   "k": "52:18",
   "n": 18,
   "c": 52,
   "text": "فَـٰكِهِينَ بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ"
  },
  {
   "k": "52:19",
   "n": 19,
   "c": 52,
   "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"
  },
  {
   "k": "52:20",
   "n": 20,
   "c": 52,
   "text": "مُتَّكِـِٔينَ عَلَىٰ سُرُرٍۢ مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍۢ"
  },
  {
   "k": "52:21",
   "n": 21,
   "c": 52,
   "text": "وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَـٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَـٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍۢ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌۭ"
  },
  {
   "k": "52:22",
   "n": 22,
   "c": 52,
   "text": "وَأَمْدَدْنَـٰهُم بِفَـٰكِهَةٍۢ وَلَحْمٍۢ مِّمَّا يَشْتَهُونَ"
  },
  {
   "k": "52:23",
   "n": 23,
   "c": 52,
   "text": "يَتَنَـٰزَعُونَ فِيهَا كَأْسًۭا لَّا لَغْوٌۭ فِيهَا وَلَا تَأْثِيمٌۭ"
  },
  {
   "k": "52:24",
   "n": 24,
   "c": 52,
   "text": "۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌۭ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌۭ مَّكْنُونٌۭ"
  },
  {
   "k": "52:25",
   "n": 25,
   "c": 52,
   "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ"
  },
  {
   "k": "52:26",
   "n": 26,
   "c": 52,
   "text": "قَالُوٓا۟ إِنَّا كُنَّا قَبْلُ فِىٓ أَهْلِنَا مُشْفِقِينَ"
  },
  {
   "k": "52:27",
   "n": 27,
   "c": 52,
   "text": "فَمَنَّ ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ"
  },
  {
   "k": "52:28",
   "n": 28,
   "c": 52,
   "text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ ۖ إِنَّهُۥ هُوَ ٱلْبَرُّ ٱلرَّحِيمُ"
  },
  {
   "k": "52:29",
   "n": 29,
   "c": 52,
   "text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍۢ وَلَا مَجْنُونٍ"
  },
  {
   "k": "52:30",
   "n": 30,
   "c": 52,
   "text": "أَمْ يَقُولُونَ شَاعِرٌۭ نَّتَرَبَّصُ بِهِۦ رَيْبَ ٱلْمَنُونِ"
  },
  {
   "k": "52:31",
   "n": 31,
   "c": 52,
   "text": "قُلْ تَرَبَّصُوا۟ فَإِنِّى مَعَكُم مِّنَ ٱلْمُتَرَبِّصِينَ"
  }
 ]
}
