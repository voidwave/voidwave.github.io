 "verses": [
  {
   "k": "3:1",
   "n": 1,
   "c": 3,
   "text": "الٓمٓ"
  },
  {
   "k": "3:2",
   "n": 2,
   "c": 3,
   "text": "ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ٱلْحَىُّ ٱلْقَيُّومُ"
  },
  {
   "k": "3:3",
   "n": 3,
   "c": 3,
   "text": "نَزَّلَ عَلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ مُصَدِّقًۭا لِّمَا بَيْنَ يَدَيْهِ وَأَنزَلَ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ"
  },
  {
   "k": "3:4",
   "n": 4,
   "c": 3,
   "text": "مِن قَبْلُ هُدًۭى لِّلنَّاسِ وَأَنزَلَ ٱلْفُرْقَانَ ۗ إِنَّ ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِ ٱللَّهِ لَهُمْ عَذَابٌۭ شَدِيدٌۭ ۗ وَٱللَّهُ عَزِيزٌۭ ذُو ٱنتِقَامٍ"
  },
  {
   "k": "3:5",
   "n": 5,
   "c": 3,
   "text": "إِنَّ ٱللَّهَ لَا يَخْفَىٰ عَلَيْهِ شَىْءٌۭ فِى ٱلْأَرْضِ وَلَا فِى ٱلسَّمَآءِ"
  },
  {
   "k": "3:6",
   "n": 6,
   "c": 3,
