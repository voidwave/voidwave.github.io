 "verses": [
  {
   "k": "19:96",
   "n": 96,
   "c": 19,
   "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَـٰنُ وُدًّۭا"
  },
  {
   "k": "19:97",
   "n": 97,
   "c": 19,
   "text": "فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوْمًۭا لُّدًّۭا"
  },
  {
   "k": "19:98",
   "n": 98,
   "c": 19,
   "text": "وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هَلْ تُحِسُّ مِنْهُم مِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا"
  },
  {
   "k": "20:1",
   "n": 1,
   "c": 20,
   "text": "طه"
  },
  {
   "k": "20:2",
   "n": 2,
   "c": 20,
   "text": "مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ"
  },
  {
   "k": "20:3",
   "n": 3,
   "c": 20,
   "text": "إِلَّا تَذْكِرَةًۭ لِّمَن يَخْشَىٰ"
  },
  {
   "k": "20:4",
   "n": 4,
   "c": 20,
   "text": "تَنزِيلًۭا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَـٰوَٰتِ ٱلْعُلَى"
  },
  {
   "k": "20:5",
   "n": 5,
   "c": 20,
   "text": "ٱلرَّحْمَـٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ"
  },
  {
   "k": "20:6",
   "n": 6,
   "c": 20,
   "text": "لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ"
  },
  {
   "k": "20:7",
   "n": 7,
   "c": 20,
   "text": "وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى"
  },
  {
   "k": "20:8",
   "n": 8,
   "c": 20,
   "text": "ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ"
  },
  {
   "k": "20:9",
   "n": 9,
   "c": 20,
   "text": "وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"
  },
  {
   "k": "20:10",
   "n": 10,
   "c": 20,
   "text": "إِذْ رَءَا نَارًۭا فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ نَارًۭا لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى ٱلنَّارِ هُدًۭى"
  },
  {
   "k": "20:11",
   "n": 11,
   "c": 20,
   "text": "فَلَمَّآ أَتَىٰهَا نُودِىَ يَـٰمُوسَىٰٓ"
  },
  {
   "k": "20:12",
   "n": 12,
   "c": 20,
   "text": "إِنِّىٓ أَنَا۠ رَبُّكَ فَٱخْلَعْ نَعْلَيْكَ ۖ إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًۭى"
  }
 ]
}
