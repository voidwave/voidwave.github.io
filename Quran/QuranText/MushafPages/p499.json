 "verses": [
  {
   "k": "45:1",
   "n": 1,
   "c": 45,
   "text": "حمٓ"
  },
  {
   "k": "45:2",
   "n": 2,
   "c": 45,
   "text": "تَنزِيلُ ٱلْكِتَـٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ"
  },
  {
   "k": "45:3",
   "n": 3,
   "c": 45,
   "text": "إِنَّ فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ لَـَٔايَـٰتٍۢ لِّلْمُؤْمِنِينَ"
  },
  {
   "k": "45:4",
   "n": 4,
   "c": 45,
   "text": "وَفِى خَلْقِكُمْ وَمَا يَبُثُّ مِن دَآبَّةٍ ءَايَـٰتٌۭ لِّقَوْمٍۢ يُوقِنُونَ"
  },
  {
   "k": "45:5",
   "n": 5,
   "c": 45,
   "text": "وَٱخْتِلَـٰفِ ٱلَّيْلِ وَٱلنَّهَارِ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن رِّزْقٍۢ فَأَحْيَا بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَا وَتَصْرِيفِ ٱلرِّيَـٰحِ ءَايَـٰتٌۭ لِّقَوْمٍۢ يَعْقِلُونَ"
  },
  {
   "k": "45:6",
   "n": 6,
   "c": 45,
   "text": "تِلْكَ ءَايَـٰتُ ٱللَّهِ نَتْلُوهَا عَلَيْكَ بِٱلْحَقِّ ۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَ ٱللَّهِ وَءَايَـٰتِهِۦ يُؤْمِنُونَ"
  },
  {
   "k": "45:7",
   "n": 7,
   "c": 45,
   "text": "وَيْلٌۭ لِّكُلِّ أَفَّاكٍ أَثِيمٍۢ"
  },
  {
   "k": "45:8",
   "n": 8,
   "c": 45,
   "text": "يَسْمَعُ ءَايَـٰتِ ٱللَّهِ تُتْلَىٰ عَلَيْهِ ثُمَّ يُصِرُّ مُسْتَكْبِرًۭا كَأَن لَّمْ يَسْمَعْهَا ۖ فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍۢ"
  },
  {
   "k": "45:9",
   "n": 9,
   "c": 45,
   "text": "وَإِذَا عَلِمَ مِنْ ءَايَـٰتِنَا شَيْـًٔا ٱتَّخَذَهَا هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌۭ مُّهِينٌۭ"
  },
  {
   "k": "45:10",
   "n": 10,
   "c": 45,
   "text": "مِّن وَرَآئِهِمْ جَهَنَّمُ ۖ وَلَا يُغْنِى عَنْهُم مَّا كَسَبُوا۟ شَيْـًۭٔا وَلَا مَا ٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ أَوْلِيَآءَ ۖ وَلَهُمْ عَذَابٌ عَظِيمٌ"
  },
  {
   "k": "45:11",
   "n": 11,
   "c": 45,
   "text": "هَـٰذَا هُدًۭى ۖ وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِ رَبِّهِمْ لَهُمْ عَذَابٌۭ مِّن رِّجْزٍ أَلِيمٌ"
  },
  {
   "k": "45:12",
   "n": 12,
   "c": 45,
   "text": "۞ ٱللَّهُ ٱلَّذِى سَخَّرَ لَكُمُ ٱلْبَحْرَ لِتَجْرِىَ ٱلْفُلْكُ فِيهِ بِأَمْرِهِۦ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ"
  },
  {
   "k": "45:13",
   "n": 13,
   "c": 45,
   "text": "وَسَخَّرَ لَكُم مَّا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ جَمِيعًۭا مِّنْهُ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يَتَفَكَّرُونَ"
  }
 ]
}
