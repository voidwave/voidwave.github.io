 "verses": [
  {
   "k": "106:1",
   "n": 1,
   "c": 106,
   "text": "لِإِيلَـٰفِ قُرَيْشٍ"
  },
  {
   "k": "106:2",
   "n": 2,
   "c": 106,
   "text": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"
  },
  {
   "k": "106:3",
   "n": 3,
   "c": 106,
   "text": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"
  },
  {
   "k": "106:4",
   "n": 4,
   "c": 106,
   "text": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ"
  },
  {
   "k": "107:1",
   "n": 1,
   "c": 107,
   "text": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"
  },
  {
   "k": "107:2",
   "n": 2,
   "c": 107,
   "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"
  },
  {
   "k": "107:3",
   "n": 3,
   "c": 107,
   "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
  },
  {
   "k": "107:4",
   "n": 4,
   "c": 107,
   "text": "فَوَيْلٌۭ لِّلْمُصَلِّينَ"
  },
  {
   "k": "107:5",
   "n": 5,
   "c": 107,
   "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"
  },
  {
   "k": "107:6",
   "n": 6,
   "c": 107,
   "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ"
  },
  {
   "k": "107:7",
   "n": 7,
   "c": 107,
   "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ"
  },
  {
   "k": "108:1",
   "n": 1,
   "c": 108,
   "text": "إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ"
  },
  {
   "k": "108:2",
