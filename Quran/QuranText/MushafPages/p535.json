 ],
 "verses": [
  {
   "k": "56:17",
   "n": 17,
   "c": 56,
   "text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ"
  },
  {
   "k": "56:18",
   "n": 18,
   "c": 56,
   "text": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ"
  },
  {
   "k": "56:19",
   "n": 19,
   "c": 56,
   "text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"
  },
  {
   "k": "56:20",
   "n": 20,
   "c": 56,
   "text": "وَفَـٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ"
  },
  {
   "k": "56:21",
   "n": 21,
   "c": 56,
   "text": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ"
  },
  {
   "k": "56:22",
   "n": 22,
   "c": 56,
   "text": "وَحُورٌ عِينٌۭ"
  },
  {
   "k": "56:23",
   "n": 23,
   "c": 56,
   "text": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"
  },
  {
   "k": "56:24",
   "n": 24,
   "c": 56,
   "text": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"
  },
  {
   "k": "56:25",
   "n": 25,
   "c": 56,
   "text": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا"
  },
  {
   "k": "56:26",
   "n": 26,
   "c": 56,
   "text": "إِلَّا قِيلًۭا سَلَـٰمًۭا سَلَـٰمًۭا"
  },
  {
   "k": "56:27",
   "n": 27,
   "c": 56,
   "text": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ"
  },
  {
   "k": "56:28",
   "n": 28,
   "c": 56,
   "text": "فِى سِدْرٍۢ مَّخْضُودٍۢ"
  },
  {
   "k": "56:29",
   "n": 29,
   "c": 56,
   "text": "وَطَلْحٍۢ مَّنضُودٍۢ"
  },
  {
   "k": "56:30",
   "n": 30,
   "c": 56,
   "text": "وَظِلٍّۢ مَّمْدُودٍۢ"
  },
  {
   "k": "56:31",
   "n": 31,
   "c": 56,
   "text": "وَمَآءٍۢ مَّسْكُوبٍۢ"
  },
  {
   "k": "56:32",
   "n": 32,
   "c": 56,
   "text": "وَفَـٰكِهَةٍۢ كَثِيرَةٍۢ"
  },
  {
   "k": "56:33",
   "n": 33,
   "c": 56,
   "text": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ"
  },
  {
   "k": "56:34",
   "n": 34,
   "c": 56,
   "text": "وَفُرُشٍۢ مَّرْفُوعَةٍ"
  },
  {
   "k": "56:35",
   "n": 35,
   "c": 56,
   "text": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءًۭ"
  },
  {
   "k": "56:36",
   "n": 36,
   "c": 56,
   "text": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا"
  },
  {
   "k": "56:37",
   "n": 37,
   "c": 56,
   "text": "عُرُبًا أَتْرَابًۭا"
  },
  {
   "k": "56:38",
   "n": 38,
   "c": 56,
   "text": "لِّأَصْحَـٰبِ ٱلْيَمِينِ"
  },
  {
   "k": "56:39",
   "n": 39,
   "c": 56,
   "text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ"
  },
  {
   "k": "56:40",
   "n": 40,
   "c": 56,
   "text": "وَثُلَّةٌۭ مِّنَ ٱلْـَٔاخِرِينَ"
  },
  {
   "k": "56:41",
   "n": 41,
   "c": 56,
   "text": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ"
  },
  {
   "k": "56:42",
   "n": 42,
   "c": 56,
   "text": "فِى سَمُومٍۢ وَحَمِيمٍۢ"
  },
  {
   "k": "56:43",
   "n": 43,
   "c": 56,
   "text": "وَظِلٍّۢ مِّن يَحْمُومٍۢ"
  },
  {
   "k": "56:44",
   "n": 44,
   "c": 56,
   "text": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ"
  },
  {
   "k": "56:45",
   "n": 45,
   "c": 56,
   "text": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ"
  },
  {
   "k": "56:46",
   "n": 46,
   "c": 56,
   "text": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ"
  },
  {
   "k": "56:47",
   "n": 47,
   "c": 56,
   "text": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"
  },
  {
   "k": "56:48",
   "n": 48,
   "c": 56,
   "text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"
  },
  {
   "k": "56:49",
   "n": 49,
   "c": 56,
   "text": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ"
  },
  {
   "k": "56:50",
   "n": 50,
   "c": 56,
   "text": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍۢ مَّعْلُومٍۢ"
  }
 ]
}
