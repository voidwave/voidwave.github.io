 "verses": [
  {
   "k": "53:1",
   "n": 1,
   "c": 53,
   "text": "وَٱلنَّجْمِ إِذَا هَوَىٰ"
  },
  {
   "k": "53:2",
   "n": 2,
   "c": 53,
   "text": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"
  },
  {
   "k": "53:3",
   "n": 3,
   "c": 53,
   "text": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ"
  },
  {
   "k": "53:4",
   "n": 4,
   "c": 53,
   "text": "إِنْ هُوَ إِلَّا وَحْىٌۭ يُوحَىٰ"
  },
  {
   "k": "53:5",
   "n": 5,
   "c": 53,
   "text": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ"
  },
  {
   "k": "53:6",
   "n": 6,
   "c": 53,
   "text": "ذُو مِرَّةٍۢ فَٱسْتَوَىٰ"
  },
  {
   "k": "53:7",
   "n": 7,
   "c": 53,
   "text": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ"
  },
  {
   "k": "53:8",
   "n": 8,
   "c": 53,
   "text": "ثُمَّ دَنَا فَتَدَلَّىٰ"
  },
  {
   "k": "53:9",
   "n": 9,
   "c": 53,
   "text": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ"
  },
  {
   "k": "53:10",
   "n": 10,
   "c": 53,
   "text": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ"
  },
  {
   "k": "53:11",
   "n": 11,
   "c": 53,
   "text": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ"
  },
  {
   "k": "53:12",
   "n": 12,
   "c": 53,
   "text": "أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ"
  },
  {
   "k": "53:13",
   "n": 13,
   "c": 53,
   "text": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ"
  },
  {
   "k": "53:14",
   "n": 14,
   "c": 53,
   "text": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ"
  },
  {
   "k": "53:15",
   "n": 15,
   "c": 53,
   "text": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ"
  },
  {
   "k": "53:16",
   "n": 16,
   "c": 53,
   "text": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ"
  },
  {
   "k": "53:17",
   "n": 17,
   "c": 53,
   "text": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ"
  },
  {
   "k": "53:18",
   "n": 18,
   "c": 53,
   "text": "لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ"
  },
  {
   "k": "53:19",
   "n": 19,
   "c": 53,
   "text": "أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ"
  },
  {
   "k": "53:20",
   "n": 20,
   "c": 53,
   "text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ"
  },
  {
   "k": "53:21",
   "n": 21,
   "c": 53,
   "text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ"
  },
  {
   "k": "53:22",
   "n": 22,
   "c": 53,
   "text": "تِلْكَ إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ"
  },
  {
   "k": "53:23",
   "n": 23,
   "c": 53,
   "text": "إِنْ هِىَ إِلَّآ أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ"
  },
  {
   "k": "53:24",
   "n": 24,
   "c": 53,
   "text": "أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ"
  },
  {
   "k": "53:25",
   "n": 25,
   "c": 53,
   "text": "فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ"
  },
  {
   "k": "53:26",
   "n": 26,
   "c": 53,
   "text": "۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ"
  }
 ]
}
