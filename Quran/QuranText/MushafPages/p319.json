 "verses": [
  {
   "k": "20:99",
   "n": 99,
   "c": 20,
   "text": "كَذَٰلِكَ نَقُصُّ عَلَيْكَ مِنْ أَنۢبَآءِ مَا قَدْ سَبَقَ ۚ وَقَدْ ءَاتَيْنَـٰكَ مِن لَّدُنَّا ذِكْرًۭا"
  },
  {
   "k": "20:100",
   "n": 100,
   "c": 20,
   "text": "مَّنْ أَعْرَضَ عَنْهُ فَإِنَّهُۥ يَحْمِلُ يَوْمَ ٱلْقِيَـٰمَةِ وِزْرًا"
  },
  {
   "k": "20:101",
   "n": 101,
   "c": 20,
   "text": "خَـٰلِدِينَ فِيهِ ۖ وَسَآءَ لَهُمْ يَوْمَ ٱلْقِيَـٰمَةِ حِمْلًۭا"
  },
  {
   "k": "20:102",
   "n": 102,
   "c": 20,
   "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ ۚ وَنَحْشُرُ ٱلْمُجْرِمِينَ يَوْمَئِذٍۢ زُرْقًۭا"
  },
  {
   "k": "20:103",
   "n": 103,
   "c": 20,
   "text": "يَتَخَـٰفَتُونَ بَيْنَهُمْ إِن لَّبِثْتُمْ إِلَّا عَشْرًۭا"
  },
  {
   "k": "20:104",
   "n": 104,
   "c": 20,
   "text": "نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ إِذْ يَقُولُ أَمْثَلُهُمْ طَرِيقَةً إِن لَّبِثْتُمْ إِلَّا يَوْمًۭا"
  },
  {
   "k": "20:105",
   "n": 105,
   "c": 20,
   "text": "وَيَسْـَٔلُونَكَ عَنِ ٱلْجِبَالِ فَقُلْ يَنسِفُهَا رَبِّى نَسْفًۭا"
  },
  {
   "k": "20:106",
   "n": 106,
   "c": 20,
   "text": "فَيَذَرُهَا قَاعًۭا صَفْصَفًۭا"
  },
  {
   "k": "20:107",
   "n": 107,
   "c": 20,
   "text": "لَّا تَرَىٰ فِيهَا عِوَجًۭا وَلَآ أَمْتًۭا"
  },
  {
   "k": "20:108",
   "n": 108,
   "c": 20,
   "text": "يَوْمَئِذٍۢ يَتَّبِعُونَ ٱلدَّاعِىَ لَا عِوَجَ لَهُۥ ۖ وَخَشَعَتِ ٱلْأَصْوَاتُ لِلرَّحْمَـٰنِ فَلَا تَسْمَعُ إِلَّا هَمْسًۭا"
  },
  {
   "k": "20:109",
   "n": 109,
   "c": 20,
   "text": "يَوْمَئِذٍۢ لَّا تَنفَعُ ٱلشَّفَـٰعَةُ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَرَضِىَ لَهُۥ قَوْلًۭا"
  },
  {
   "k": "20:110",
   "n": 110,
   "c": 20,
   "text": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِهِۦ عِلْمًۭا"
  },
  {
   "k": "20:111",
   "n": 111,
   "c": 20,
   "text": "۞ وَعَنَتِ ٱلْوُجُوهُ لِلْحَىِّ ٱلْقَيُّومِ ۖ وَقَدْ خَابَ مَنْ حَمَلَ ظُلْمًۭا"
  },
  {
   "k": "20:112",
   "n": 112,
   "c": 20,
   "text": "وَمَن يَعْمَلْ مِنَ ٱلصَّـٰلِحَـٰتِ وَهُوَ مُؤْمِنٌۭ فَلَا يَخَافُ ظُلْمًۭا وَلَا هَضْمًۭا"
  },
  {
   "k": "20:113",
   "n": 113,
   "c": 20,
   "text": "وَكَذَٰلِكَ أَنزَلْنَـٰهُ قُرْءَانًا عَرَبِيًّۭا وَصَرَّفْنَا فِيهِ مِنَ ٱلْوَعِيدِ لَعَلَّهُمْ يَتَّقُونَ أَوْ يُحْدِثُ لَهُمْ ذِكْرًۭا"
  }
 ]
}
