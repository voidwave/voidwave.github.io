 "verses": [
  {
   "k": "69:9",
   "n": 9,
   "c": 69,
   "text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ"
  },
  {
   "k": "69:10",
   "n": 10,
   "c": 69,
   "text": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً"
  },
  {
   "k": "69:11",
   "n": 11,
   "c": 69,
   "text": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ"
  },
  {
   "k": "69:12",
   "n": 12,
   "c": 69,
   "text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ"
  },
  {
   "k": "69:13",
   "n": 13,
   "c": 69,
   "text": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ"
  },
  {
   "k": "69:14",
   "n": 14,
   "c": 69,
   "text": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ"
  },
  {
   "k": "69:15",
   "n": 15,
   "c": 69,
   "text": "فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ"
  },
  {
   "k": "69:16",
   "n": 16,
   "c": 69,
   "text": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ"
  },
  {
   "k": "69:17",
   "n": 17,
   "c": 69,
   "text": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَـٰنِيَةٌۭ"
  },
  {
   "k": "69:18",
   "n": 18,
   "c": 69,
   "text": "يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ"
  },
  {
   "k": "69:19",
   "n": 19,
   "c": 69,
   "text": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ"
  },
  {
   "k": "69:20",
   "n": 20,
   "c": 69,
   "text": "إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ"
  },
  {
   "k": "69:21",
   "n": 21,
   "c": 69,
   "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ"
  },
  {
   "k": "69:22",
   "n": 22,
   "c": 69,
   "text": "فِى جَنَّةٍ عَالِيَةٍۢ"
  },
  {
   "k": "69:23",
   "n": 23,
   "c": 69,
   "text": "قُطُوفُهَا دَانِيَةٌۭ"
  },
  {
   "k": "69:24",
   "n": 24,
   "c": 69,
   "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ"
  },
  {
   "k": "69:25",
   "n": 25,
   "c": 69,
   "text": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ"
  },
  {
   "k": "69:26",
   "n": 26,
   "c": 69,
   "text": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ"
  },
  {
   "k": "69:27",
   "n": 27,
   "c": 69,
   "text": "يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ"
  },
  {
   "k": "69:28",
   "n": 28,
   "c": 69,
   "text": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ"
  },
  {
   "k": "69:29",
   "n": 29,
   "c": 69,
   "text": "هَلَكَ عَنِّى سُلْطَـٰنِيَهْ"
  },
  {
   "k": "69:30",
   "n": 30,
   "c": 69,
   "text": "خُذُوهُ فَغُلُّوهُ"
  },
  {
   "k": "69:31",
   "n": 31,
   "c": 69,
   "text": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ"
  },
  {
   "k": "69:32",
   "n": 32,
   "c": 69,
   "text": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ"
  },
  {
   "k": "69:33",
   "n": 33,
   "c": 69,
   "text": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ"
  },
  {
   "k": "69:34",
   "n": 34,
   "c": 69,
   "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
  }
 ]
}
