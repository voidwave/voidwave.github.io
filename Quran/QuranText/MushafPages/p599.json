 "verses": [
  {
   "k": "98:6",
   "n": 6,
   "c": 98,
   "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ ۚ أُو۟لَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ"
  },
  {
   "k": "98:7",
   "n": 7,
   "c": 98,
   "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ"
  },
  {
   "k": "98:8",
   "n": 8,
   "c": 98,
   "text": "جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍۢ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًۭا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ"
  },
  {
   "k": "99:1",
   "n": 1,
   "c": 99,
   "text": "إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"
  },
  {
   "k": "99:2",
   "n": 2,
   "c": 99,
   "text": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"
  },
  {
   "k": "99:3",
   "n": 3,
   "c": 99,
   "text": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا"
  },
  {
   "k": "99:4",
   "n": 4,
   "c": 99,
   "text": "يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا"
  },
  {
   "k": "99:5",
   "n": 5,
   "c": 99,
   "text": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"
  },
  {
   "k": "99:6",
   "n": 6,
   "c": 99,
   "text": "يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ"
  },
  {
   "k": "99:7",
   "n": 7,
   "c": 99,
   "text": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ"
  },
  {
   "k": "99:8",
   "n": 8,
   "c": 99,
   "text": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ"
  },
  {
   "k": "100:1",
   "n": 1,
   "c": 100,
   "text": "وَٱلْعَـٰدِيَـٰتِ ضَبْحًۭا"
  },
  {
   "k": "100:2",
   "n": 2,
   "c": 100,
   "text": "فَٱلْمُورِيَـٰتِ قَدْحًۭا"
  },
  {
   "k": "100:3",
   "n": 3,
   "c": 100,
   "text": "فَٱلْمُغِيرَٰتِ صُبْحًۭا"
  },
  {
   "k": "100:4",
   "n": 4,
   "c": 100,
   "text": "فَأَثَرْنَ بِهِۦ نَقْعًۭا"
  },
  {
   "k": "100:5",
   "n": 5,
   "c": 100,
   "text": "فَوَسَطْنَ بِهِۦ جَمْعًا"
  }
 ]
}
