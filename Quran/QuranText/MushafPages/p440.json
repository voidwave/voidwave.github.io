 "verses": [
  {
   "k": "35:45",
   "n": 45,
   "c": 35,
   "text": "وَلَوْ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِمَا كَسَبُوا۟ مَا تَرَكَ عَلَىٰ ظَهْرِهَا مِن دَآبَّةٍۢ وَلَـٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍۢ مُّسَمًّۭى ۖ فَإِذَا جَآءَ أَجَلُهُمْ فَإِنَّ ٱللَّهَ كَانَ بِعِبَادِهِۦ بَصِيرًۢا"
  },
  {
   "k": "36:1",
   "n": 1,
   "c": 36,
   "text": "يسٓ"
  },
  {
   "k": "36:2",
   "n": 2,
   "c": 36,
   "text": "وَٱلْقُرْءَانِ ٱلْحَكِيمِ"
  },
  {
   "k": "36:3",
   "n": 3,
   "c": 36,
   "text": "إِنَّكَ لَمِنَ ٱلْمُرْسَلِينَ"
  },
  {
   "k": "36:4",
   "n": 4,
   "c": 36,
   "text": "عَلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ"
  },
  {
   "k": "36:5",
   "n": 5,
   "c": 36,
   "text": "تَنزِيلَ ٱلْعَزِيزِ ٱلرَّحِيمِ"
  },
  {
   "k": "36:6",
   "n": 6,
   "c": 36,
   "text": "لِتُنذِرَ قَوْمًۭا مَّآ أُنذِرَ ءَابَآؤُهُمْ فَهُمْ غَـٰفِلُونَ"
  },
  {
   "k": "36:7",
   "n": 7,
   "c": 36,
   "text": "لَقَدْ حَقَّ ٱلْقَوْلُ عَلَىٰٓ أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِنُونَ"
  },
  {
   "k": "36:8",
   "n": 8,
   "c": 36,
   "text": "إِنَّا جَعَلْنَا فِىٓ أَعْنَـٰقِهِمْ أَغْلَـٰلًۭا فَهِىَ إِلَى ٱلْأَذْقَانِ فَهُم مُّقْمَحُونَ"
  },
  {
   "k": "36:9",
   "n": 9,
   "c": 36,
   "text": "وَجَعَلْنَا مِنۢ بَيْنِ أَيْدِيهِمْ سَدًّۭا وَمِنْ خَلْفِهِمْ سَدًّۭا فَأَغْشَيْنَـٰهُمْ فَهُمْ لَا يُبْصِرُونَ"
  },
  {
   "k": "36:10",
   "n": 10,
   "c": 36,
   "text": "وَسَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ"
  },
  {
   "k": "36:11",
   "n": 11,
   "c": 36,
   "text": "إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَةٍۢ وَأَجْرٍۢ كَرِيمٍ"
  },
  {
   "k": "36:12",
   "n": 12,
   "c": 36,
   "text": "إِنَّا نَحْنُ نُحْىِ ٱلْمَوْتَىٰ وَنَكْتُبُ مَا قَدَّمُوا۟ وَءَاثَـٰرَهُمْ ۚ وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ فِىٓ إِمَامٍۢ مُّبِينٍۢ"
  }
 ]
}
