 "verses": [
  {
   "k": "55:70",
   "n": 70,
   "c": 55,
   "text": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ"
  },
  {
   "k": "55:71",
   "n": 71,
   "c": 55,
   "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
  },
  {
   "k": "55:72",
   "n": 72,
   "c": 55,
   "text": "حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ"
  },
  {
   "k": "55:73",
   "n": 73,
   "c": 55,
   "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
  },
  {
   "k": "55:74",
   "n": 74,
   "c": 55,
   "text": "لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ"
  },
  {
   "k": "55:75",
   "n": 75,
   "c": 55,
   "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
  },
  {
   "k": "55:76",
   "n": 76,
   "c": 55,
   "text": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ"
  },
  {
   "k": "55:77",
   "n": 77,
   "c": 55,
   "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
  },
  {
   "k": "55:78",
   "n": 78,
   "c": 55,
   "text": "تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ"
  },
  {
   "k": "56:1",
   "n": 1,
   "c": 56,
   "text": "إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"
  },
  {
   "k": "56:2",
   "n": 2,
   "c": 56,
   "text": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"
  },
  {
   "k": "56:3",
   "n": 3,
   "c": 56,
   "text": "خَافِضَةٌۭ رَّافِعَةٌ"
  },
  {
   "k": "56:4",
   "n": 4,
   "c": 56,
   "text": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا"
  },
  {
   "k": "56:5",
   "n": 5,
   "c": 56,
   "text": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا"
  },
  {
   "k": "56:6",
   "n": 6,
   "c": 56,
   "text": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا"
  },
  {
   "k": "56:7",
   "n": 7,
   "c": 56,
   "text": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَـٰثَةًۭ"
  },
  {
   "k": "56:8",
   "n": 8,
   "c": 56,
   "text": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"
  },
  {
   "k": "56:9",
   "n": 9,
   "c": 56,
   "text": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"
  },
  {
   "k": "56:10",
   "n": 10,
   "c": 56,
   "text": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ"
  },
  {
   "k": "56:11",
   "n": 11,
   "c": 56,
   "text": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ"
  },
  {
   "k": "56:12",
   "n": 12,
   "c": 56,
   "text": "فِى جَنَّـٰتِ ٱلنَّعِيمِ"
  },
  {
   "k": "56:13",
   "n": 13,
   "c": 56,
   "text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ"
  },
  {
   "k": "56:14",
   "n": 14,
   "c": 56,
   "text": "وَقَلِيلٌۭ مِّنَ ٱلْـَٔاخِرِينَ"
  },
  {
   "k": "56:15",
   "n": 15,
   "c": 56,
   "text": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ"
  },
  {
   "k": "56:16",
   "n": 16,
   "c": 56,
   "text": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ"
  }
 ]
}
